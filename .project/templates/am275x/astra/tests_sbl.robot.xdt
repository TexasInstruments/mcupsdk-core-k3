%%{
/*
 * Template: tests_sbl.robot.xdt
 *
 * Use this template for SBL (Secondary Bootloader) examples that flash
 * a bootloader image to non-volatile storage using UartUniFlash, then
 * optionally reboot the board from that storage. Requires cfgPath pointing
 * to a .cfg file under tools/boot/sbl_prebuilt/.
 *
 * Supported examples: sbl_ospi, sbl_null, sbl_emmc
 *
 * Flow:
 *   1. Flash via UartUniFlash.WITH CFG
 *   2. Connect to logPort (USB2 for wkup-r5fss0-0)
 *   3. If bootMode set: CHANGE BOOT MODE -> DUT OFF/ON -> EXPECT
 *      "Image loading done" on logPort -> EXPECT expectedString on sblPort (ACM0)
 *   4. If bootMode not set (sbl_null): EXPECT expectedString on logPort directly
 *
 * Key options: cfgPath (required), bootMode (optional, e.g. XSPI_1S_BOOT_MODE)
 */
    let options  = args.options;
    let project  = args.project;

    let sblPort = "ACM0";
    let logPort = "ACM0";
    if (project.cpu.match(/wkup-r5f/)) {
        logPort = "USB2";
    } else if (project.cpu.match(/c75/)) {
        logPort = "USB0";
    }
    let expectedString = (options && options.expectedString) ? options.expectedString : "All tests have passed";
    let timeout        = (options && options.timeout)        ? options.timeout        : 700;
    let expectTimeout  = (options && options.expectTimeout)  ? options.expectTimeout  : 300;
    let componentName  = (options && options.componentName)  ? options.componentName  : "SBL";
    let testCaseIds    = (options && options.testCaseIds)    ? options.testCaseIds    : "SITSW-XXXXX";
    let testCaseName   = (options && options.testCaseName)   ? options.testCaseName   : componentName + " application";
    let bootMode       = (options && options.bootMode)       ? options.bootMode       : null;
    let finalPort      = bootMode ? sblPort : logPort;

    let coreName = project.cpu + "_" + project.os;
    let cfgFile  = "${SDK_PATH}/" + options.cfgPath;
%%}
*** Comments ***
`componentName` `coreName` TEST FILE

*** Settings ***
Documentation    Suite for `componentName` `coreName` TESTING

# ------------- Resource Files ---------------------
Resource    test_infra.resource

# ------------- Setup and Teardown ---------------------
Test Setup    INFRA_TEST_SETUP
Test Teardown    INFRA_TEST_TEARDOWN

*** Variables ***

${CFG_FILE}    `cfgFile`


*** Test Cases ***
`testCaseName`
	[Tags]    core:`coreName`    component:`componentName`    app_name:`project.name`	`testCaseIds`
	[Timeout]    `timeout`
	DUT ON
	CHANGE BOOT MODE    ${UART_BOOT_MODE}
	DUT OFF
	DUT ON
	Sleep    2s
	DUT`sblPort`.CONNECT TO UART PORT    ${`sblPort`}
	DUT`sblPort`.EXPECT STRING AT UART PORT    CCC
	UartUniFlash.WITH CFG    ${`sblPort`}    ${UartUniFlashPath}    ${CFG_FILE}
	DUT`logPort`.CONNECT TO UART PORT    ${`logPort`}
% if (bootMode) {
	CHANGE BOOT MODE    ${`bootMode`}
	DUT OFF
	DUT ON
	DUT`logPort`.EXPECT STRING AT UART PORT    Image loading done    300
% }
	DUT`finalPort`.EXPECT STRING AT UART PORT    `expectedString`    `expectTimeout`
