%%{
/*
 * Template: tests_sbl.robot.xdt (am275x)
 *
 * Port mapping:
 *   sblPort = ACM0 (UART0/ttyACM0 — MAIN R5F and bootloader)
 *   logPort = USB2 (WKUP_UART/ttyUSB2) for wkup-r5fss0-0
 *           = USB0 (UART2/ttyUSB0)     for c75
 *           = ACM0                     for all other cores
 *
 * Options:
 *   cfgPath      — path to uniflash .cfg (required)
 *   bootMode     — boot mode after flash (e.g. XSPI_1S_BOOT_MODE); null = no reboot
 *   timeout, expectTimeout
 *   expectations: [{port, string}] — sequential port/string checks after flash/boot
 *   expectedString, finalPort      — fallback single-string check (backward compat)
 */
    let options  = args.options;
    let project  = args.project;

    let sblPort = "ACM0";
    let logPort = "ACM0";
    if (project.cpu.match(/wkup-r5f/)) {
        logPort = "USB2";
    } else if (project.cpu.match(/c75/)) {
        logPort = "USB0";
    }
    let expectedString = (options && options.expectedString) ? options.expectedString : "All tests have passed";
    let timeout        = (options && options.timeout)        ? options.timeout        : 700;
    let expectTimeout  = (options && options.expectTimeout)  ? options.expectTimeout  : 300;
    let componentName  = (options && options.componentName)  ? options.componentName  : "SBL";
    let testCaseIds    = (options && options.testCaseIds)    ? options.testCaseIds.trim().split(/\s+/).join("    ") : "SITSW-XXXXX";
    let testCaseName   = (options && options.testCaseName)   ? options.testCaseName   : componentName + " application";
    let bootMode       = (options && options.hasOwnProperty('bootMode')) ? options.bootMode : null;
    let finalPort      = bootMode ? sblPort : logPort;
    // expectations: [{port, string}] — overrides expectedString/finalPort when set
    let expectations   = (options && options.expectations)  ? options.expectations   : null;
    let stressIterations = (options && options.stressIterations != null) ? options.stressIterations : null;

    let coreName = project.cpu + "_" + project.os;
    let cfgFile  = "${SDK_PATH}/" + options.cfgPath.replace("{board}", project.board).replace("{coreName}", project.cpu + "_" + project.os);
%%}
*** Comments ***
`componentName` `coreName` TEST FILE

*** Settings ***
Documentation    Suite for `componentName` `coreName` TESTING

# ------------- Resource Files ---------------------
Resource    test_infra.resource

# ------------- Setup and Teardown ---------------------
Test Setup    INFRA_TEST_SETUP
Test Teardown    INFRA_TEST_TEARDOWN

*** Variables ***

${DEVICE_TYPE}    ${{ 'hs' if 'hsse' in '${PLATFORM}' else 'hs_fs' }}
${CFG_FILE}    `cfgFile`


*** Test Cases ***
`testCaseName`
	[Tags]    core:`coreName`    component:`componentName`    app_name:`project.name`    `testCaseIds`
	[Timeout]    `timeout`
	DUT ON
	CHANGE BOOT MODE    ${UART_BOOT_MODE}
	DUT OFF
	DUT ON
	Sleep    2s
	DUT`sblPort`.CONNECT TO UART PORT    ${`sblPort`}
	DUT`sblPort`.EXPECT STRING AT UART PORT    CCC
	UartUniFlash.WITH CFG    ${`sblPort`}    ${UartUniFlashPath}    ${CFG_FILE}
% if (bootMode) {
	CHANGE BOOT MODE    ${`bootMode`}
%     if (stressIterations !== null) {
	FOR    ${index}     IN RANGE    `stressIterations`
	    Log To Console    This is iteration number: ${index}
	    DUT OFF
%         if (expectations) {
%             { const allPorts = [...new Set(expectations.map(e => e.port))]; for (let p of allPorts) {
	    DUT`p`.CONNECT TO UART PORT    ${`p`}
%             } } // end allPorts for
%         } else { // single logPort + sblPort
	    DUT`logPort`.CONNECT TO UART PORT    ${`logPort`}
	    DUT`sblPort`.CONNECT TO UART PORT    ${`sblPort`}
%         } // end if (expectations)
	    DUT ON
%         if (expectations) {
%             for (let exp of expectations) {
	    DUT`exp.port`.EXPECT STRING AT UART PORT    `exp.string`    `expectTimeout`
%             } // end for expectations
%         } else { // single expectedString
	    DUT`finalPort`.EXPECT STRING AT UART PORT    `expectedString`    `expectTimeout`
%         } // end if (expectations)
	END
%     } else { // stressIterations === null — single boot
	DUT OFF
%         if (expectations) {
%             { const seenPorts = [...new Set(expectations.map(e => e.port))].filter(p => p !== sblPort); for (let p of seenPorts) {
	DUT`p`.CONNECT TO UART PORT    ${`p`}
%             } } // end seenPorts for (non-sblPort only)
%         } else { // single logPort
	DUT`logPort`.CONNECT TO UART PORT    ${`logPort`}
%         } // end if (expectations)
	DUT ON
%         if (expectations) {
%             for (let exp of expectations) {
	DUT`exp.port`.EXPECT STRING AT UART PORT    `exp.string`    `expectTimeout`
%             } // end for expectations
%         } else { // single expectedString
	DUT`finalPort`.EXPECT STRING AT UART PORT    `expectedString`    `expectTimeout`
%         } // end if (expectations)
%     } // end if (stressIterations)
% } else { // !bootMode
	DUT`logPort`.CONNECT TO UART PORT    ${`logPort`}
%     if (expectations) {
%         for (let exp of expectations) {
	DUT`exp.port`.EXPECT STRING AT UART PORT    `exp.string`    `expectTimeout`
%         } // end for expectations
%     } else { // single expectedString
	DUT`finalPort`.EXPECT STRING AT UART PORT    `expectedString`    `expectTimeout`
%     } // end if (expectations)
% } // end if (bootMode)
