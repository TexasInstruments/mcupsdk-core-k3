%%{
/*
 * Template: tests.robot.xdt (am62px)
 *
 * Use this template for am62px examples using the standard UartBootloader
 * WITH ARGS (default) or WITH CFG (withCfg: true) boot flow.
 *
 * Port mapping (sblPort is always USB0 on am62px):
 *   - wkup-r5fss* → logPort: USB2
 *   - mcu-r5fss*  → logPort: USB3
 *
 * DM binary:
 *   - mcu-r5fss0-0: auto-added → ipc_rpmsg_echo/{board}/wkup-r5fss0-0_freertos/...appimage.${DEVICE_TYPE}
 *   - wkup-r5fss0-0: no DM binary (it is the DM core)
 *
 * Supports interactPrompt/interactSend for interactive UART tests.
 */
    let options  = args.options;
    let project  = args.project;

    let sblPort = "USB0";
    let logPort = "USB2";
    if (project.cpu.match(/mcu-r5fss/)) logPort = "USB3";

    let expectedString = (options && options.expectedString) ? options.expectedString : "All tests have passed";
    let timeout        = (options && options.timeout)        ? options.timeout        : 630;
    let expectTimeout  = (options && options.expectTimeout)  ? options.expectTimeout  : 30;
    let componentName  = (options && options.componentName)  ? options.componentName  : project.name;
    let testCaseIds    = (options && options.testCaseIds)    ? options.testCaseIds.trim().split(/\s+/).join("    ") : "SITSW-XXXXX";
    let testCaseName   = (options && options.testCaseName)   ? options.testCaseName   : componentName + " application";
    let interactPrompt        = (options && options.interactPrompt)        ? options.interactPrompt        : null;
    let interactSend          = (options && options.interactSend)          ? options.interactSend          : [];
    let interactPromptTimeout = (options && options.interactPromptTimeout) ? options.interactPromptTimeout : 20;
    let secondPort            = (options && options.secondPort)            ? options.secondPort            : null;
    let secondPortSend        = (options && options.secondPortSend)        ? options.secondPortSend        : [];
    let expectations          = (options && options.expectations)          ? options.expectations          : null;
    let withCfg        = (options && options.withCfg)        ? true                   : false;
    // DM binary — auto-added for mcu-r5fss cores; wkup-r5fss is the DM core (no DM binary)
    let appBinaryDM = project.cpu.match(/mcu-r5fss/)
        ? "examples/drivers/ipc/ipc_rpmsg_echo/" + project.board + "/wkup-r5fss0-0_freertos/ti-arm-clang/ipc_rpmsg_echo.release.appimage.${DEVICE_TYPE}"
        : null;

    let coreName  = project.cpu + "_" + project.os;
    let sbl       = "sbl_prebuilt/" + project.board + "/sbl_uart.release.${DEVICE_TYPE}.tiimage";
    let appName      = (options && options.appName)      ? options.appName      : project.name;
    let appBinaryName = (options && options.appBinaryName) ? options.appBinaryName : project.name;
    let appBinaryExt = (options && options.appBinaryExt) ? options.appBinaryExt : "appimage.${DEVICE_TYPE}";
    let appBinary = "../../" + project.relpath + "/" + project.board + "/" + coreName + "/" + project.cgt + "/" + appBinaryName + ".release." + appBinaryExt;
    let cfgFile   = options.cfgPath
                   ? "${SDK_PATH}/" + options.cfgPath.replace("{board}", project.board).replace("{coreName}", project.cpu + "_" + project.os)
                   : null;
%%}
*** Comments ***
`componentName` `coreName` TEST FILE

*** Settings ***
Documentation    Suite for `componentName` `coreName` TESTING

# ------------- Resource Files ---------------------
Resource    test_infra.resource

# ------------- Setup and Teardown ---------------------
Test Setup    INFRA_TEST_SETUP
Test Teardown    INFRA_TEST_TEARDOWN

*** Variables ***

${SOC}    `project.device`
${DEVICE_TYPE}    ${{ 'hs' if 'hsse' in '${PLATFORM}' else 'hs_fs' }}
% if (withCfg) {
${CFG_FILE}    `cfgFile`
% } else {
${SBL}    `sbl`
${APP_BINARY}    `appBinary`
% if (appBinaryDM) {
${DM_BINARY}    ../../`appBinaryDM`
% }
% }

*** Test Cases ***
`testCaseName`
	[Tags]    core:`coreName`    component:`componentName`    app_name:`appName`    `testCaseIds`
	[Timeout]    `timeout`
	DUT ON
	CHANGE BOOT MODE    ${UART_BOOT_MODE}
	DUT OFF
	DUT ON
	Sleep    2s
	DUT`sblPort`.CONNECT TO UART PORT    ${`sblPort`}
	DUT`sblPort`.EXPECT STRING AT UART PORT    CCC
% if (withCfg) {
	UartBootloader.WITH CFG    ${`sblPort`}    ${UartBootloaderPath}    ${CFG_FILE}
% } else {
% if (appBinaryDM) {
	UartBootloader.WITH ARGS    ${`sblPort`}    ${UartBootloaderPath}    --bootloader=${SBL} --file=${APP_BINARY} --file=${DM_BINARY}
% } else {
	UartBootloader.WITH ARGS    ${`sblPort`}    ${UartBootloaderPath}    --soc=${SOC} --bootloader=${SBL} --file=${APP_BINARY}
% }
% }
% if (expectations) {
%   const expPorts = [...new Set(expectations.filter(e => e.port).map(e => e.port))];
%   for (let p of expPorts) {
	DUT`p`.CONNECT TO UART PORT    ${`p`}
%   }
% } else {
	DUT`logPort`.CONNECT TO UART PORT    ${`logPort`}
% if (secondPort) {
	DUT`secondPort`.CONNECT TO UART PORT    ${`secondPort`}
% }
% }
% if (expectations) {
%   for (let exp of expectations) {
%     if (exp.string !== undefined) {
	DUT`exp.port`.EXPECT STRING AT UART PORT    `exp.string`    `exp.timeout !== undefined ? exp.timeout : expectTimeout`
%     }
%     if (exp.send) {
%       for (let cmd of exp.send) {
%         if (exp.sendEnterFalse) {
	DUT`exp.port`.SEND COMMAND AND VERIFY    `cmd`    send_enter=${False}
%         } else {
	DUT`exp.port`.SEND COMMAND AND VERIFY    `cmd`
%         }
%       }
%     }
%   }
% } else {
% if (interactPrompt) {
	DUT`logPort`.EXPECT STRING AT UART PORT    `interactPrompt`    `interactPromptTimeout`
% for (let cmd of interactSend) {
	DUT`logPort`.SEND COMMAND AND VERIFY    `cmd`
% }
% }
% for (let cmd of secondPortSend) {
	DUT`secondPort`.SEND COMMAND AND VERIFY    `cmd`
% }
	DUT`logPort`.EXPECT STRING AT UART PORT    `expectedString`     `expectTimeout`
% }
