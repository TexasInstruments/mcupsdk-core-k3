%%{
/*
 * Template: tests_sbl.robot.xdt (am62x)
 *
 * Port mapping (sblPort is USB0 on am62x):
 *   USB0 — UART0/ttyUSB0 (A53/bootloader)
 *   USB2 — WKUP_UART/ttyUSB2 (r5fss0-0)
 *   USB3 — MCU_UART/ttyUSB3 (m4fss0-0)
 *
 * Options:
 *   cfgPath / cfgFileName — cfg file path
 *   bootMode              — boot mode after flash (default: null = no reboot)
 *   useBootloader         — use UartBootloader instead of UartUniFlash (default: false)
 *   timeout, expectTimeout
 *   expectations: [{port, string}] — sequential port/string checks after boot
 *   expectedString, expectPort    — fallback single-string check
 */
    let options  = args.options;
    let project  = args.project;

    let componentName  = (options && options.componentName)  ? options.componentName  : "SBL";
    let testCaseName   = (options && options.testCaseName)   ? options.testCaseName   : componentName + " application";
    let appName        = (options && options.appName)        ? options.appName        : project.name;
    let testCaseIds    = (options && options.testCaseIds)    ? options.testCaseIds.trim().split(/\s+/).join("    ") : "SITSW-XXXXX";
    let expectedString = (options && options.expectedString) ? options.expectedString : "All tests have passed";
    let timeout        = (options && options.timeout)        ? options.timeout        : 700;
    let expectTimeout  = (options && options.expectTimeout)  ? options.expectTimeout  : 100;
    let bootMode       = (options && options.hasOwnProperty('bootMode')) ? options.bootMode : null;
    let useBootloader  = (options && options.useBootloader)  ? true                   : false;
    let expectPort     = (options && options.expectPort)     ? options.expectPort     : "USB2";
    let expectations   = (options && options.expectations)  ? options.expectations   : null;

    let coreName = project.cpu + "_" + project.os;
    let cfgFile  = options.cfgPath
                   ? "${SDK_PATH}/" + options.cfgPath.replace("{board}", project.board).replace("{coreName}", project.cpu + "_" + project.os)
                   : "${SDK_PATH}/tools/boot/sbl_prebuilt/" + project.board + "/" + options.cfgFileName;
%%}
*** Comments ***
`componentName` `coreName` TEST FILE

*** Settings ***
Documentation    Suite for `componentName` `coreName` TESTING

# ------------- Resource Files ---------------------
Resource    test_infra.resource

# ------------- Setup and Teardown ---------------------
Test Setup    INFRA_TEST_SETUP
Test Teardown    INFRA_TEST_TEARDOWN

*** Variables ***

${DEVICE_TYPE}    ${{ 'hs' if 'hsse' in '${PLATFORM}' else 'hs_fs' }}
${CFG_FILE}    `cfgFile`

*** Test Cases ***
`testCaseName`
	[Tags]    board:`project.board`    core:`coreName`    component:`componentName`    app_name:`appName`    `testCaseIds`
	[Timeout]    `timeout`
	DUT ON
	CHANGE BOOT MODE    ${UART_BOOT_MODE}
	DUT OFF
	DUT ON
	Sleep    2s
% if (useBootloader) {
	UartBootloader.WITH CFG    ${USB0}    ${UartBootloaderPath}    ${CFG_FILE}
% } else {
	UartUniFlash.WITH CFG    ${USB0}    ${UartUniFlashPath}    ${CFG_FILE}
% }
% if (bootMode) {
	CHANGE BOOT MODE    ${`bootMode`}
	DUT OFF
% if (expectations) {
% { const seenPorts = [...new Set(expectations.map(e => e.port))]; for (let p of seenPorts) {
	DUT`p`.CONNECT TO UART PORT    ${`p`}
% } }
% } else {
	DUT`expectPort`.CONNECT TO UART PORT    ${`expectPort`}
% }
	DUT ON
% } else {
	DUTUSB2.CONNECT TO UART PORT    ${USB2}
% }
% if (expectations) {
% for (let exp of expectations) {
	DUT`exp.port`.EXPECT STRING AT UART PORT    `exp.string`    `expectTimeout`
% }
% } else {
	DUT`expectPort`.EXPECT STRING AT UART PORT    `expectedString`    `expectTimeout`
% }
