%%{
/*
 * Template: tests_sbl_linux.robot.xdt (am62x)
 *
 * Port mapping:
 *   USB0 — A53 Linux console (UART0/ttyUSB0)
 *   USB2 — WKUP_UART/ttyUSB2 (r5fss0-0)
 *   USB3 — MCU_UART/ttyUSB3 (m4fss0-0)
 *
 * Options:
 *   cfgPath / cfgFileName — cfg file to flash
 *   bootMode              — boot mode after flash (default: OSPI_NAND_BOOT_MODE)
 *   timeout               — test timeout (default: 1000)
 *   expectTimeout         — per-string timeout (default: 100)
 *   useNFS                — if true, call NFS.SETUP NFS USING UBOOT AND BOOT before expectations
 *   useBootloader         — if true, use UartBootloader (UART boot) instead of UartUniFlash (OSPI flash)
 *   boardExpectations     — {[board]: [{port, string, send?, timeout?}]} per-board expectations map
 *   expectations: [{port, string, send?, timeout?}]
 *     - {port, string}         → DUT{port}.EXPECT STRING AT UART PORT
 *     - {port, send, string}   → DUT{port}.SEND COMMAND AND VERIFY {send} {string}
 */
    let options  = args.options;
    let project  = args.project;

    let componentName  = (options && options.componentName)  ? options.componentName  : "SBL";
    let testCaseName   = (options && options.testCaseName)   ? options.testCaseName   : componentName + " Linux application";
    let appName        = (options && options.appName)        ? options.appName        : project.name;
    let testCaseIds    = (options && options.testCaseIds)    ? options.testCaseIds.trim().split(/\s+/).join("    ") : "SITSW-XXXXX";
    let bootMode       = (options && options.hasOwnProperty('bootMode')) ? options.bootMode : "OSPI_NAND_BOOT_MODE";
    let timeout        = (options && options.timeout)        ? options.timeout        : 1000;
    let expectTimeout  = (options && options.expectTimeout)  ? options.expectTimeout  : 100;
    let useNFS         = (options && options.useNFS)         ? true                   : false;
    let useBootloader  = (options && options.useBootloader)  ? true                   : false;
    let expectations   = (options && options.boardExpectations && options.boardExpectations[project.board])
                         ? options.boardExpectations[project.board]
                         : (options && options.expectations) ? options.expectations : [];
    let stressIterations = (options && options.stressIterations != null) ? options.stressIterations : null;

    let coreName = project.cpu + "_" + project.os;
    let cfgFile  = options.cfgPath
                   ? "${SDK_PATH}/" + options.cfgPath.replace("{board}", project.board).replace("{coreName}", project.cpu + "_" + project.os)
                   : "${SDK_PATH}/tools/boot/sbl_prebuilt/" + project.board + "/" + options.cfgFileName;
%%}
*** Comments ***
`componentName` `coreName` TEST FILE

*** Settings ***
Documentation    Suite for `componentName` `coreName` TESTING

# ------------- Resource Files ---------------------
Resource    test_infra.resource

# ------------- Setup and Teardown ---------------------
Test Setup    INFRA_TEST_SETUP
Test Teardown    INFRA_TEST_TEARDOWN

*** Variables ***

${DEVICE_TYPE}    ${{ 'hs' if 'hsse' in '${PLATFORM}' else 'hs_fs' }}
${CFG_FILE}    `cfgFile`

*** Test Cases ***
`testCaseName`
	[Tags]    board:`project.board`    core:`coreName`    component:`componentName`    app_name:`appName`    `testCaseIds`
	[Timeout]    `timeout`
	DUT ON
	CHANGE BOOT MODE    ${UART_BOOT_MODE}
	DUT OFF
	DUT ON
	Sleep    2s
% if (useBootloader) {
	DUTUSB0.CONNECT TO UART PORT    ${USB0}
	DUTUSB0.EXPECT STRING AT UART PORT    CCC
	UartBootloader.WITH CFG    ${USB0}    ${UartBootloaderPath}    ${CFG_FILE}
%     { const seenPorts = [...new Set(expectations.map(e => e.port))]; for (let p of seenPorts) {
	DUT`p`.CONNECT TO UART PORT    ${`p`}
%     } } // end seenPorts for
%     if (useNFS) {
	NFS.SETUP NFS USING UBOOT AND BOOT    USB0
%     } // end if (useNFS)
%     for (let exp of expectations) {
%         if (exp.send !== undefined) {
	DUT`exp.port`.SEND COMMAND AND VERIFY    `exp.send`    `exp.string`    `exp.timeout !== undefined ? exp.timeout : expectTimeout`
%         } else { // exp.send === undefined
	DUT`exp.port`.EXPECT STRING AT UART PORT    `exp.string`    `exp.timeout !== undefined ? exp.timeout : expectTimeout`
%         } // end if (exp.send)
%     } // end for expectations
% } else { // !useBootloader — UartUniFlash path
	UartUniFlash.WITH CFG    ${USB0}    ${UartUniFlashPath}    ${CFG_FILE}
%     if (bootMode) {
%         { const seenPorts = [...new Set(expectations.map(e => e.port))]; for (let p of seenPorts) {
	DUT`p`.CONNECT TO UART PORT    ${`p`}
%         } } // end seenPorts for
	CHANGE BOOT MODE    ${`bootMode`}
%         if (stressIterations !== null) {
	FOR    ${index}     IN RANGE    `stressIterations`
	    Log To Console    This is iteration number: ${index}
	    DUT OFF
%             { const seenPorts = [...new Set(expectations.map(e => e.port))]; for (let p of seenPorts) {
	    DUT`p`.CONNECT TO UART PORT    ${`p`}
%             } } // end seenPorts for
	    DUT ON
%             if (useNFS) {
	    NFS.SETUP NFS USING UBOOT AND BOOT    USB0
%             } // end if (useNFS)
%             for (let exp of expectations) {
%                 if (exp.send !== undefined) {
	    DUT`exp.port`.SEND COMMAND AND VERIFY    `exp.send`    `exp.string`    `exp.timeout !== undefined ? exp.timeout : expectTimeout`
%                 } else { // exp.send === undefined
	    DUT`exp.port`.EXPECT STRING AT UART PORT    `exp.string`    `exp.timeout !== undefined ? exp.timeout : expectTimeout`
%                 } // end if (exp.send)
%             } // end for expectations
	END
%         } else { // stressIterations === null — single boot
	DUT OFF
	DUT ON
%             if (useNFS) {
	NFS.SETUP NFS USING UBOOT AND BOOT    USB0
%             } // end if (useNFS)
%             for (let exp of expectations) {
%                 if (exp.send !== undefined) {
	DUT`exp.port`.SEND COMMAND AND VERIFY    `exp.send`    `exp.string`    `exp.timeout !== undefined ? exp.timeout : expectTimeout`
%                 } else { // exp.send === undefined
	DUT`exp.port`.EXPECT STRING AT UART PORT    `exp.string`    `exp.timeout !== undefined ? exp.timeout : expectTimeout`
%                 } // end if (exp.send)
%             } // end for expectations
%         } // end if (stressIterations)
%     } // end if (bootMode)
% } // end if (useBootloader)
