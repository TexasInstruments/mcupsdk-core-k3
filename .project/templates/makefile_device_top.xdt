%%{
    let component_target_list_string = [];
    let component_target_external_list_string = [];
    let component_target_private_list_string = [];
    let component_target_prebuilt_list_string = [];
    let component_target_clean_list_string = [];
    let component_target_scrub_list_string = [];
    let component_target_external_clean_list_string = [];
    let component_target_external_scrub_list_string = [];
    let component_target_prebuilt_clean_list_string = [];
    let component_target_prebuilt_scrub_list_string = [];
    let component_target_xlibs_list_string = [];
    let component_target_xlibs_clean_list_string = [];
    let component_target_xlibs_scrub_list_string = [];
	let component_target_clean_private_list_string = [];
	let component_target_scrub_private_list_string = [];
    let xlibSupported = (args.device == "am62dx" || args.device == "am275x");
    let hsmSupported = !args.isInternal && (args.device == "am62x" || args.device == "am62ax" || args.device == "am62dx" || args.device == "am62px" || args.device == "am275x");
    let linuxSupported = !args.isInternal && (args.device == "am62x" || args.device == "am62ax" || args.device == "am62px");
    let hsmToolDir = (args.device == "am275x") ? "HSMMCELFImageGen" : "HSMAppimageGen";
    for (component of args.component_list) {
        if(component.isXlibs) {
            component_target_xlibs_list_string +=` \$(BUILD_COMBO_${component.name})`
            component_target_xlibs_clean_list_string +=` \$(BUILD_COMBO_CLEAN_${component.name})`
            component_target_xlibs_scrub_list_string +=` \$(BUILD_COMBO_SCRUB_${component.name})`
        }
        else if(component.isExternalLibrary) {
            component_target_external_list_string +=` \$(BUILD_COMBO_${component.name})`
            component_target_external_clean_list_string +=` \$(BUILD_COMBO_CLEAN_${component.name})`
            component_target_external_scrub_list_string +=` \$(BUILD_COMBO_SCRUB_${component.name})`
        }
        else if(component.isSkipTopLevelBuild) {
            component_target_private_list_string +=` \$(BUILD_COMBO_${component.name})`
            if (args.device != "j722s") {
                component_target_clean_list_string +=` \$(BUILD_COMBO_CLEAN_${component.name})`
                component_target_scrub_list_string +=` \$(BUILD_COMBO_SCRUB_${component.name})`
            }
            else {
                component_target_clean_private_list_string +=` \$(BUILD_COMBO_CLEAN_${component.name})`
                component_target_scrub_private_list_string +=` \$(BUILD_COMBO_SCRUB_${component.name})`
            }
        }
        else if(component.isPrebuilt) {
            component_target_prebuilt_list_string +=` \$(BUILD_COMBO_${component.name})`
            component_target_prebuilt_clean_list_string +=` \$(BUILD_COMBO_CLEAN_${component.name})`
            component_target_prebuilt_scrub_list_string +=` \$(BUILD_COMBO_SCRUB_${component.name})`
        }
        else {
            component_target_list_string +=` \$(BUILD_COMBO_${component.name})`
            component_target_clean_list_string +=` \$(BUILD_COMBO_CLEAN_${component.name})`
            component_target_scrub_list_string +=` \$(BUILD_COMBO_SCRUB_${component.name})`
        }
    }
%%}
#
# Auto generated makefile
#

% if (xlibSupported) {
BUILD_XLIBS ?= no

% }
all:
	$(MAKE) -f makefile.`device` libs
	$(MAKE) -f makefile.`device` libs-external
	$(MAKE) -f makefile.`device` sbl
	$(MAKE) -f makefile.`device` examples
% if (hsmSupported) {
	$(MAKE) -f makefile.`device` hsm
% }

% if (hsmSupported) {
clean: libs-clean libs-external-clean sbl-clean examples-clean hsm-clean
scrub: libs-scrub libs-external-scrub sbl-scrub examples-scrub hsm-scrub
% } else {
clean: libs-clean libs-external-clean sbl-clean examples-clean
scrub: libs-scrub libs-external-scrub sbl-scrub examples-scrub
% }
% if (hsmSupported) {

hsm:
	$(MAKE) -C tools/boot/`hsmToolDir` DEVICE=`device` all

hsm-clean:
	$(MAKE) -C tools/boot/`hsmToolDir` DEVICE=`device` clean

hsm-scrub:
	$(MAKE) -C tools/boot/`hsmToolDir` DEVICE=`device` clean
% }
% if (linuxSupported) {

linux:
	$(MAKE) -C tools/boot/linuxAppimageGen DEVICE=`device` all

linux-clean:
	$(MAKE) -C tools/boot/linuxAppimageGen DEVICE=`device` clean

linux-scrub:
	$(MAKE) -C tools/boot/linuxAppimageGen DEVICE=`device` clean
% }
% if (device == "j722s") {

all-private: libs-private
	$(MAKE) -f makefile.`device` examples-private

scrub-private: libs-private-scrub examples-scrub-private
%}

help:
	@echo  Notes,
	@echo  - Use -j to invoke parallel builds
	@echo  - Use PROFILE=debug or PROFILE=release [default] to build in debug or release profile
	@echo  .
	@echo  Overall build targets,
	@echo  ======================
	@echo  $(MAKE) -s -f makefile.`device` help
	@echo  .
	@echo  $(MAKE) -s -f makefile.`device` all
	@echo  $(MAKE) -s -f makefile.`device` clean  # delete's tmp files for current profile
	@echo  $(MAKE) -s -f makefile.`device` scrub  # delete's all tmp files and folders for all profiles
	@echo  .
	@echo  $(MAKE) -s -f makefile.`device` libs
	@echo  $(MAKE) -s -f makefile.`device` libs-clean # delete's tmp files for current profile
	@echo  $(MAKE) -s -f makefile.`device` libs-scrub # delete's all tmp files and folders for all profiles
	@echo  .
	@echo  $(MAKE) -s -f makefile.`device` examples
	@echo  $(MAKE) -s -f makefile.`device` examples-clean # delete's tmp files for current profile
	@echo  $(MAKE) -s -f makefile.`device` examples-scrub # delete's all tmp files and folders for all profiles
	@echo  .
	@echo  Library build targets,
	@echo  ======================
% for (component of args.component_list) {
	@echo  $(MAKE) -s -f makefile.`device``component.buildTarget`
% }
	@echo  .
	@echo  Library clean targets,
	@echo  ======================
% for (component of args.component_list) {
	@echo  $(MAKE) -s -f makefile.`device``component.buildTargetClean`
% }
	@echo  .
	@echo  Example build targets,
	@echo  ======================
% for (example of args.example_list) {
	@echo  $(MAKE) -s -C `example.relpath` [all clean syscfg-gui syscfg]
% }
	@echo  .
	@echo  System Example build targets,
	@echo  =============================
% for (example of args.system_example_list) {
	@echo  $(MAKE) -s -C `example.relpath` [all clean syscfg-gui syscfg]
% }
	@echo  .

# Various Component Targets
% for (component of args.component_list) {
BUILD_COMBO_`component.name` =`component.buildTarget`
% }

# Combine all Components
BUILD_COMBO_ALL =`component_target_list_string`

# Combine all External Components
BUILD_COMBO_EXTERNAL_ALL =`component_target_external_list_string`

# Combine all Pre-built Components
BUILD_COMBO_PREBUILT_ALL =`component_target_prebuilt_list_string`

# Combine all Private Components
BUILD_COMBO_PRIVATE_ALL =`component_target_private_list_string`

% if (xlibSupported) {
# xlibs Components (not built on Windows)
ifneq ($(OS),Windows_NT)
ifeq ($(BUILD_XLIBS),yes)
BUILD_COMBO_XLIBS_ALL =`component_target_xlibs_list_string`
BUILD_COMBO_XLIBS_CLEAN_ALL =`component_target_xlibs_clean_list_string`
BUILD_COMBO_XLIBS_SCRUB_ALL =`component_target_xlibs_scrub_list_string`
else
BUILD_COMBO_XLIBS_ALL =
BUILD_COMBO_XLIBS_CLEAN_ALL =
BUILD_COMBO_XLIBS_SCRUB_ALL =
endif
else
BUILD_COMBO_XLIBS_ALL =
BUILD_COMBO_XLIBS_CLEAN_ALL =
BUILD_COMBO_XLIBS_SCRUB_ALL =
endif
% }

% if (xlibSupported) {
libs: $(BUILD_COMBO_ALL) $(BUILD_COMBO_XLIBS_ALL)
% } else {
libs: $(BUILD_COMBO_ALL)
% }

libs-external: $(BUILD_COMBO_EXTERNAL_ALL)

libs-prebuilt: $(BUILD_COMBO_PREBUILT_ALL)

libs-private: $(BUILD_COMBO_PRIVATE_ALL)

% for (component of args.component_list) {
%   let depStr = "";
%   if(component.dependencies) {
%       for(let dep of component.dependencies) {
%           depStr += " $(BUILD_COMBO_" + dep + ")";
%       }
%   }
$(BUILD_COMBO_`component.name`):` depStr `
	$(MAKE) -C `component.relpath` -f makefile`component.tag`.`args.device`.$(subst `component.name`_,,$@) all

% }

# Various Component Clean Targets
% for (component of args.component_list) {
BUILD_COMBO_CLEAN_`component.name` =`component.buildTargetClean`
% }

# Combine all Components Clean
BUILD_COMBO_CLEAN_ALL =`component_target_clean_list_string`

# Combine all External Components Clean
BUILD_COMBO_EXTERNAL_CLEAN_ALL =`component_target_external_clean_list_string`

# Combine all Pre-built Components Clean
BUILD_COMBO_PREBUILT_CLEAN_ALL =`component_target_prebuilt_clean_list_string`

% if (device == "j722s") {
# Combine all Private Components Clean
BUILD_COMBO_PRIVATE_CLEAN_ALL =`component_target_clean_private_list_string`

% }
% if (xlibSupported) {
libs-clean: $(BUILD_COMBO_CLEAN_ALL) $(BUILD_COMBO_XLIBS_CLEAN_ALL)
% } else {
libs-clean: $(BUILD_COMBO_CLEAN_ALL)
% }

libs-external-clean: $(BUILD_COMBO_EXTERNAL_CLEAN_ALL)

libs-prebuilt-clean: $(BUILD_COMBO_PREBUILT_CLEAN_ALL)

% if (device == "j722s") {
libs-private-clean: $(BUILD_COMBO_PRIVATE_CLEAN_ALL)

% }
% for (component of args.component_list) {
$(BUILD_COMBO_CLEAN_`component.name`):
	$(MAKE) -C `component.relpath` -f makefile`component.tag`.`args.device`.$(subst `component.name`_,,$(subst _clean,,$@)) clean

% }

# Various Component Scrub Targets
% for (component of args.component_list) {
BUILD_COMBO_SCRUB_`component.name` =`component.buildTargetScrub`
% }

# Combine all Components Scrub Targets
BUILD_COMBO_SCRUB_ALL =`component_target_scrub_list_string`

# Combine all External Components Scrub Targets
BUILD_COMBO_EXTERNAL_SCRUB_ALL =`component_target_external_scrub_list_string`

# Combine all Pre-built Components Scrub Targets
BUILD_COMBO_PREBUILT_SCRUB_ALL =`component_target_prebuilt_scrub_list_string`

% if (device == "j722s") {
# Combine all Private Components Scrub Targets
BUILD_COMBO_PRIVATE_SCRUB_ALL =`component_target_scrub_private_list_string`

% }
% if (xlibSupported) {
libs-scrub: $(BUILD_COMBO_SCRUB_ALL) $(BUILD_COMBO_XLIBS_SCRUB_ALL)
% } else {
libs-scrub: $(BUILD_COMBO_SCRUB_ALL)
% }

libs-external-scrub: $(BUILD_COMBO_EXTERNAL_SCRUB_ALL)

libs-prebuilt-scrub: $(BUILD_COMBO_PREBUILT_SCRUB_ALL)

% if (device == "j722s") {
libs-private-scrub: $(BUILD_COMBO_PRIVATE_SCRUB_ALL)

% }
% for (component of args.component_list) {
$(BUILD_COMBO_SCRUB_`component.name`):
	$(MAKE) -C `component.relpath` -f makefile`component.tag`.`args.device`.$(subst `component.name`_,,$(subst _scrub,,$@)) scrub

% }

BUILD_COMBO_EXAMPLE_ALL =
# Various Example Targets
% for (example of args.example_list) {
%   if(!example.isSkipTopLevelBuild && !example.isBootLoader && !example.isXlibs) {
BUILD_COMBO_EXAMPLE_ALL +=`example.buildTarget`
%   }
% }
# Various System Example Targets
% for (example of args.system_example_list) {
%   if(!example.isSkipTopLevelBuild && !example.isXlibs) {
BUILD_COMBO_EXAMPLE_ALL +=`example.buildTarget`
%   }
% }

% if (xlibSupported) {
BUILD_COMBO_EXAMPLE_XLIBS_ALL =
# Various xlibs Example Targets
% for (example of args.example_list) {
%   if(example.isXlibs && !example.isBootLoader) {
BUILD_COMBO_EXAMPLE_XLIBS_ALL +=`example.buildTarget`
%   }
% }
# Various xlibs System Example Targets
% for (example of args.system_example_list) {
%   if(example.isXlibs) {
BUILD_COMBO_EXAMPLE_XLIBS_ALL +=`example.buildTarget`
%   }
% }
% }

BUILD_COMBO_EXAMPLE_PRIVATE_ALL =
# Various Private Example Targets
% for (example of args.example_list) {
%   if(example.isSkipTopLevelBuild && !example.isBootLoader) {
BUILD_COMBO_EXAMPLE_PRIVATE_ALL +=`example.buildTarget`
%   }
% }
# Various Private System Example Targets
% for (example of args.system_example_list) {
%   if(example.isSkipTopLevelBuild) {
BUILD_COMBO_EXAMPLE_PRIVATE_ALL +=`example.buildTarget`
%   }
% }
% if (args.device == "j722s") {
DM_APP_PATH = `args.dm_app_path`

dm_app:
	$(MAKE) -C $(DM_APP_PATH) -f makefile all

examples: dm_app
	$(MAKE) -f makefile.`device` $(BUILD_COMBO_EXAMPLE_ALL)

examples-private: dm_app
	$(MAKE) -f makefile.`device` $(BUILD_COMBO_EXAMPLE_PRIVATE_ALL)
% }
% else {

% if (xlibSupported) {
ifeq ($(BUILD_XLIBS),yes)
examples: $(BUILD_COMBO_EXAMPLE_ALL) $(BUILD_COMBO_EXAMPLE_XLIBS_ALL)
else
examples: $(BUILD_COMBO_EXAMPLE_ALL)
endif

examples-xlibs: $(BUILD_COMBO_EXAMPLE_XLIBS_ALL)

% } else {
examples: $(BUILD_COMBO_EXAMPLE_ALL)

% }
examples-private: $(BUILD_COMBO_EXAMPLE_PRIVATE_ALL)
% }

% for (example of args.example_list) {
`example.buildTarget`:
	$(MAKE) -C `example.relpath` -f makefile all

% }
% for (example of args.system_example_list) {
`example.buildTarget`:
	$(MAKE) -C `example.relpath` -f makefile all

% }

BUILD_COMBO_EXAMPLE_CLEAN_ALL =
# Various Example Clean Targets
% for (example of args.example_list) {
%   if(!example.isSkipTopLevelBuild && !example.isBootLoader && !example.isXlibs) {
BUILD_COMBO_EXAMPLE_CLEAN_ALL +=`example.buildTargetClean`
%   }
% }
# Various System Example Clean Targets
% for (example of args.system_example_list) {
%   if(!example.isSkipTopLevelBuild && !example.isXlibs) {
BUILD_COMBO_EXAMPLE_CLEAN_ALL +=`example.buildTargetClean`
%   }
% }

% if (xlibSupported) {
BUILD_COMBO_EXAMPLE_XLIBS_CLEAN_ALL =
# Various xlibs Example Clean Targets
% for (example of args.example_list) {
%   if(example.isXlibs && !example.isBootLoader) {
