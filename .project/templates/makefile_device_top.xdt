% for (example of args.example_list) {
`example.buildTargetScrub`:
	$(MAKE) -C `example.relpath` -f makefile scrub

% }
% for (example of args.system_example_list) {
`example.buildTargetScrub`:
	$(MAKE) -C `example.relpath` -f makefile scrub

% }

sbl: libs
% for (example of args.example_list) {
% if(example.isBootLoader) {
	$(MAKE) -C `example.relpath` -f makefile all
%}
%}

sbl-clean:
% for (example of args.example_list) {
% if(example.isBootLoader) {
	$(MAKE) -C `example.relpath` -f makefile clean
%}
%}

sbl-scrub:
% for (example of args.example_list) {
% if(example.isBootLoader) {
	$(MAKE) -C `example.relpath` -f makefile scrub
%}
%}

% if ((device == "am64x") || (device == "am243x")) {
sbl-hs:
% for (example of args.example_list) {
% if(example.isBootLoader) {
	$(MAKE) -C `example.relpath` -f makefile all DEVICE_TYPE=HS
%}
%}

sbl-hs-clean:
% for (example of args.example_list) {
% if(example.isBootLoader) {
	$(MAKE) -C `example.relpath` -f makefile clean DEVICE_TYPE=HS
%}
%}

sbl-hs-scrub:
% for (example of args.example_list) {
% if(example.isBootLoader) {
	$(MAKE) -C `example.relpath` -f makefile scrub DEVICE_TYPE=HS
%}
%}
% }

% if (device == "am62ax") {
host-emu:
	$(MAKE) -C source/drivers/dmautils -f makefile.am62ax.c75x.ti-c7x-hostemu all

host-emu-clean:
	$(MAKE) -C source/drivers/dmautils -f makefile.am62ax.c75x.ti-c7x-hostemu clean

host-emu-scrub:
	$(MAKE) -C source/drivers/dmautils -f makefile.am62ax.c75x.ti-c7x-hostemu scrub
%}
% if (device == "j722s") {
host-emu:
	$(MAKE) -C source/drivers/dmautils -f makefile.j722s.c75ssx-0.ti-c7x-hostemu all

host-emu-clean:
	$(MAKE) -C source/drivers/dmautils -f makefile.j722s.c75ssx-0.ti-c7x-hostemu clean

host-emu-scrub:
	$(MAKE) -C source/drivers/dmautils -f makefile.j722s.c75ssx-0.ti-c7x-hostemu scrub
%}

% var count = 0
% for (example of args.example_list) {
%   if(example.isSDL ) {
%       count = count + 1 
%   }
% }
% if (count > 0) {
BUILD_COMBO_SDL_ALL =
# Various Example Targets
% for (example of args.example_list) {
%   if(example.isSDL ) {
BUILD_COMBO_SDL_ALL +=`example.buildTarget`
%   }
% }

sdl-unit-tests: $(BUILD_COMBO_SDL_ALL)

.PHONY: $(BUILD_COMBO_SDL_ALL)
.PHONY: sdl-unit-tests
% }
.PHONY: all clean scrub help
% if (hsmSupported) {
.PHONY: hsm hsm-clean hsm-scrub
% }
% if (linuxSupported) {
.PHONY: linux linux-clean linux-scrub
% }
.PHONY: libs libs-clean libs-scrub
.PHONY: libs-external libs-external-clean libs-external-scrub
.PHONY: libs-private
.PHONY: libs-prebuilt libs-prebuilt-clean libs-prebuilt-scrub
.PHONY: examples examples-clean examples-scrub
% if (xlibSupported) {
.PHONY: examples-xlibs examples-xlibs-clean examples-xlibs-scrub
% }
.PHONY: examples-private examples-private-clean examples-private-scrub
.PHONY: sbl sbl-clean sbl-scrub
.PHONY: $(BUILD_COMBO_ALL) $(BUILD_COMBO_CLEAN_ALL) $(BUILD_COMBO_SCRUB_ALL)
% if (xlibSupported) {
.PHONY: $(BUILD_COMBO_XLIBS_ALL) $(BUILD_COMBO_XLIBS_CLEAN_ALL) $(BUILD_COMBO_XLIBS_SCRUB_ALL)
% }
.PHONY: $(BUILD_COMBO_EXAMPLE_ALL) $(BUILD_COMBO_EXAMPLE_CLEAN_ALL) $(BUILD_COMBO_EXAMPLE_SCRUB_ALL)
% if (xlibSupported) {
.PHONY: $(BUILD_COMBO_EXAMPLE_XLIBS_ALL) $(BUILD_COMBO_EXAMPLE_XLIBS_CLEAN_ALL) $(BUILD_COMBO_EXAMPLE_XLIBS_SCRUB_ALL)
% }
.PHONY: $(BUILD_COMBO_EXAMPLE_PRIVATE_ALL) $(BUILD_COMBO_EXAMPLE_PRIVATE_CLEAN_ALL) $(BUILD_COMBO_EXAMPLE_PRIVATE_SCRUB_ALL)
