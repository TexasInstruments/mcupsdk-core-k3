% if (imageFormat == "mcelf") {

CG_TOOL_ROOT=$(CGT_TI_ARM_CLANG_PATH)
CC=$(CG_TOOL_ROOT)/bin/tiarmclang
LNK=$(CG_TOOL_ROOT)/bin/tiarmclang

% if(args.options && args.options.isOptishare === true) {
sso: optisave

coreout: sso.out
	@echo .
	@echo generating files with sso
% for (let project of args.project.projects) {
	$(MAKE) -C ../`project.cpu`_`project.os`/`project.cgt`/ coreout SYSTEM_FLAG=${SYSTEM_FLAG} SSO_PATH=../../system_freertos/sso.out
% }
	@echo generating files with sso done!
	@echo .

sso.out: sso.cmd
	@echo .
	@echo generating sso.out
	$(CC) -Wl,sso.cmd.tmp -o sso.out -Wl,--xml_link_info=sso.lnkxml -Wl,--gen_xml_func_hash
	@echo done
	@echo .

sso.cmd: all $(COREXMLS)
	@echo .
	@echo generating sso.cmd.tmp
	$(OPTISHARE) -o sso.cmd.tmp $(COREXMLS) -s sso.info.tmp --mem_spec optishare_memmap.json
	@echo generating sso.cmd done
	@echo .

optisave: buildmcelfsso
% for (let project of args.project.projects) {
	$(OPTISAVE) ../`project.cpu`_`project.os`/`project.cgt`/`args.project.name`.$(PROFILE).lnkxml ../`project.cpu`_`project.os`/`project.cgt`/`args.project.name`.$(PROFILE).optishare.lnkxml > ../`project.cpu`_`project.os`/`project.cgt`/`args.project.name`.$(PROFILE).ossr
% }

buildmcelfsso: coreout
	@echo .
	@echo generating mcelf with sso
	$(PYTHON) $(MCELF_IMAGE_GEN) $(CORE_IMG_OPTISHARE_ARGS) --output=$(MULTI_CORE_BOOTIMAGE_NAME_OPTISHARE) --xip=$(MCELF_XIP_RANGE) --sw_version=$(SW_VERSION) --sso=sso.out
	$(PYTHON) $(APP_IMAGE_SIGN_CMD) --bin $(MULTI_CORE_BOOTIMAGE_NAME_OPTISHARE) --authtype 0  --loadaddr `targetLoadAddress` --key $(APP_SIGNING_KEY) --output $(MULTI_CORE_BOOTIMAGE_NAME_OPTISHARE_HS_FS) --keyversion $(VERSION)
	@echo  Boot multi-core ELF image: $(MULTI_CORE_BOOTIMAGE_PATH)/$@ Done !!!
	@echo  .
	$(MAKE) sso.mcelf

sso.mcelf: sso.out
	@echo .
	@echo generating standalone sso.mcelf from sso.out ...
	$(PYTHON) $(MCELF_IMAGE_GEN) --core-img=1:sso.out --output=sso.mcelf --xip=$(MCELF_XIP_RANGE) --sw_version=$(SW_VERSION)
	$(PYTHON) $(APP_IMAGE_SIGN_CMD) --bin sso.mcelf --authtype 0 --loadaddr `targetLoadAddress` --key $(APP_SIGNING_KEY) --output sso.mcelf.hs_fs --keyversion $(VERSION)
	@echo  sso.mcelf and sso.mcelf.hs_fs generated !!!
	@echo  .

% }
MCELF_IMAGE_GEN = $(MCU_PLUS_SDK_PATH)/tools/boot/multicoreELFImageGen/genimage.py
% } else {
MULTI_CORE_IMAGE_GEN = $(SYSCFG_NODE) $(MCU_PLUS_SDK_PATH)/tools/boot/multicoreImageGen/multicoreImageGen.js
OUTRPRC_CMD = $(SYSCFG_NODE) $(MCU_PLUS_SDK_PATH)/tools/boot/out2rprc/elf2rprc.js
% }
% if ((args.project.device == "am243x") || (args.project.device == "am64x") || (args.project.device == "am62x") || (args.project.device == "am62ax") || (args.project.device == "am62dx") || (args.project.device == "am62px") || (args.project.device == "j722s") || (args.project.device == "am275x") || (args.project.device == "am62lx")) {
APP_IMAGE_SIGN_CMD = $(MCU_PLUS_SDK_PATH)/tools/boot/signing/appimage_x509_cert_gen.py
% }

% if (imageFormat == "mcelf") {
MULTI_CORE_APP_PARAMS = \
% for (let project of args.project.projects) {
    --core-img=$(BOOTIMAGE_CORE_ID_`project.cpu`):../`project.cpu`_`project.os`/`project.cgt`/`args.project.name`.$(PROFILE).out \
% }

MCELF_XIP_RANGE?=0x60100000:0x60200000
% } else {
% if (atf_build == true) {
ifeq ($(ATF_INTEGRATED_BOOT), yes)
MULTI_CORE_APP_PARAMS = \
	$(ATF_RPRC_NAME)@$(BOOTIMAGE_CORE_ID_a53ss0-0) \
% for (let project of args.project.projects) {
% if (project.cpu.match(/a53*/)) {
    ../`project.cpu`_`project.os`/`project.cgt`/`args.project.name`.$(PROFILE).rprc@$(BOOTIMAGE_CORE_ID_load_only) \
% }
% else {
    ../`project.cpu`_`project.os`/`project.cgt`/`args.project.name`.$(PROFILE).rprc@$(BOOTIMAGE_CORE_ID_`project.cpu`) \
% }
% }

else
MULTI_CORE_APP_PARAMS = \
% for (let project of args.project.projects) {
    ../`project.cpu`_`project.os`/`project.cgt`/`args.project.name`.$(PROFILE).rprc@$(BOOTIMAGE_CORE_ID_`project.cpu`) \
% }

endif
% }
% else {
MULTI_CORE_APP_PARAMS = \
% for (let project of args.project.projects) {
    %if( (args.project.device == "am62ax") || (args.project.device == "am62dx")){
        % if(project.isPartOfSystemProject == true){
        ../`project.cpu`_`project.os`/`project.cgt`/`args.project.name`.$(PROFILE).rprc@$(BOOTIMAGE_CORE_ID_`project.cpu`) \
        %}
    %}
    % else {
    ../`project.cpu`_`project.os`/`project.cgt`/`args.project.name`.$(PROFILE).rprc@$(BOOTIMAGE_CORE_ID_`project.cpu`) \
    %}
% }
% }

MULTI_CORE_APP_PARAMS_XIP = \
% for (let project of args.project.projects) {
    % if((args.project.device == "am62ax") || (args.project.device == "am62dx")){
        %if(project.isPartOfSystemProject == true){
        ../`project.cpu`_`project.os`/`project.cgt`/`args.project.name`.$(PROFILE).rprc_xip@$(BOOTIMAGE_CORE_ID_`project.cpu`) \
        %}
    %}
    % else{
    ../`project.cpu`_`project.os`/`project.cgt`/`args.project.name`.$(PROFILE).rprc_xip@$(BOOTIMAGE_CORE_ID_`project.cpu`) \
    %}
% }
% }

% if (args.project.device == "awr294x") {
MULTI_CORE_APP_PARAMS_QSPI = $(MULTI_CORE_APP_PARAMS) $(R4_RPRC_PATH)@$(BOOTIMAGE_CORE_ID_r4)

% }
% if (imageFormat == "mcelf") {
