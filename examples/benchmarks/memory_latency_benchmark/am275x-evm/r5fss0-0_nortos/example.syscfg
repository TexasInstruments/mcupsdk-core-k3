mpu_armv78.$name      = "MSRAM_BANK1_1";

mpu_armv79.baseAddr = 0x72180000;
mpu_armv79.size     = 19;
mpu_armv79.$name    = "MSRAM_BANK2";

mpu_armv710.baseAddr = 0x72200000;
mpu_armv710.size     = 21;
mpu_armv710.$name    = "MSRAM_BANK3";
