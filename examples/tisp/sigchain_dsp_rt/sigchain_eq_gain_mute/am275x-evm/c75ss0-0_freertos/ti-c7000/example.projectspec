<?xml version="1.0" encoding="UTF-8"?>
<projectSpec>
    <applicability>
        <when>
            <context
                deviceFamily="C7000"
                deviceId="TMS320C75XX.AM275x"
            />
        </when>
    </applicability>

    <project
        title="Sigchain Eq Gain Mute"
        name = "sigchain_eq_gain_mute_am275x-evm_c75ss0-0_freertos_ti-c7000"
        products="sysconfig;com.ti.MCU_PLUS_SDK_AMXXX"
        configurations="
            Debug,
            Release,
        "
        connection="TIXDS110_Connection.xml"
        toolChain="TI"
        cgtVersion=""
        device="TMS320C75XX.AM275x"
        deviceCore=""
        ignoreDefaultDeviceSettings="true"
        ignoreDefaultCCSSettings="true"
        endianness="little"
        outputFormat="ELF"
        outputType="executable"

        compilerBuildOptions="
            -I${CG_TOOL_ROOT}/include
            -I${MCU_PLUS_SDK_PATH}/source
            -I${MCU_PLUS_SDK_PATH}/source/kernel/freertos/FreeRTOS-Kernel/include
            -I${MCU_PLUS_SDK_PATH}/source/kernel/freertos/portable/TI_CGT/DSP_C75X
            -I${MCU_PLUS_SDK_PATH}/source/kernel/freertos/config/am275x/c75x
            -I${MCU_PLUS_SDK_PATH}/source/fftlib/src/
            -I${MCU_PLUS_SDK_PATH}/source/dsplib/src/
            -I${MCU_PLUS_SDK_PATH}/source/audiolib/src/
            -I${MCU_PLUS_SDK_PATH}/source/mathlib/src/
            -I${MCU_PLUS_SDK_PATH}/source/tisp/includes
            -I${MCU_PLUS_SDK_PATH}/source/tisp/test/common/
            -I${MCU_PLUS_SDK_PATH}/examples/tisp/sigchain_dsp_rt/common/inc
            -I../../..
            -mv7524
            -q
            -mo
            -pden
            -pds=238
            -pds=880
            -pds1110
            --disable_inlining
            -ea.se71
            --emit_warnings_as_errors
            --diag_suppress=770
            --diag_suppress=69
            --diag_suppress=70
            -DBUILD_C7X
            -DBUILD_C7X_1
            --diag_suppress=2824
            --diag_suppress=1557
            --diag_suppress=1
            -DSOC_AM275X
            -DMCU_PLUS_SDK
            -DBUILD_C7X_1
            -DBUILD_C7X
            -DSOC_AM275X
            -DDMA_UTILS_STANDALONE
        "
        linkerBuildOptions="
            -i${MCU_PLUS_SDK_PATH}/source/fs/freertos_fat/lib
            -i${MCU_PLUS_SDK_PATH}/source/kernel/freertos/lib
            -i${MCU_PLUS_SDK_PATH}/source/drivers/lib
            -i${MCU_PLUS_SDK_PATH}/source/fs/freertos_fat/lib
            -i${MCU_PLUS_SDK_PATH}/source/board/lib
            -i${MCU_PLUS_SDK_PATH}/source/tisp/lib/${ConfigName}
            -i${MCU_PLUS_SDK_PATH}/source/dsplib/lib/${ConfigName}
            -i${MCU_PLUS_SDK_PATH}/source/fftlib/lib/${ConfigName}
            -i${MCU_PLUS_SDK_PATH}/source/audiolib/lib/${ConfigName}
            -i${MCU_PLUS_SDK_PATH}/source/mathlib/lib/${ConfigName}
            -i${MCU_PLUS_SDK_PATH}/source/drivers/udma/lib
            -i${MCU_PLUS_SDK_PATH}/source/drivers/dmautils/lib
            -i${CG_TOOL_ROOT}/lib
            -m=sigchain_eq_gain_mute.${ConfigName}.map
            -z
            --emit_warnings_as_errors
            --diag_suppress=10063
            --ram_model
            --warn_sections
            -x
        "

        postBuildStep="$(MAKE) -C ${CCS_PROJECT_DIR} -f makefile_ccs_bootimage_gen OUTNAME=${BuildArtifactFileBaseName} PROFILE=${ConfigName} MCU_PLUS_SDK_PATH=${MCU_PLUS_SDK_PATH} CG_TOOL_ROOT=${CG_TOOL_ROOT} CCS_INSTALL_DIR=${CCS_INSTALL_DIR} CCS_IDE_MODE=${CCS_IDE_MODE}"

        enableSysConfigTool="true"
        sysConfigBuildOptions="
            --context c75ss0-0 --part AM2754 --package ANJ
        "

        description="A Sigchain Eq Gain Mute FREERTOS project">

        <configuration name="Debug"
            compilerBuildOptions="
                -Dxdc_target_name__=C71
                -D_DEBUG_=1
                --opt_level=0
                --symdebug:dwarf
            "
            linkerBuildOptions="
                -lfreertos.am275x.c75x.ti-c7000.debug.lib
                -ldrivers.am275x.c75x.ti-c7000.debug.lib
                -lTISP_C7524.lib
                -lDSPLIB_C7524.lib
                -lDSPLIB_common_C7524.lib
                -lMATHLIB_C7524.lib
                -lFFTLIB_C7524.lib
                -lFFTLIB_common_C7524.lib
                -lAUDIOLIB_C7524.lib
                -lAUDIOLIB_common_C7524.lib
                -ludma.am275x.c75x.ti-c7000.debug.lib
                -ldmautils.am275x.c75x.ti-c7000.debug.lib
                -llibc.a
            "
        ></configuration>
        <configuration name="Release"
            compilerBuildOptions="
                -Dxdc_target_name__=C71
                --opt_level=3
                --symdebug:none
            "
            linkerBuildOptions="
                -lfreertos.am275x.c75x.ti-c7000.release.lib
                -ldrivers.am275x.c75x.ti-c7000.release.lib
                -lTISP_C7524.lib
                -lDSPLIB_C7524.lib
                -lDSPLIB_common_C7524.lib
                -lMATHLIB_C7524.lib
                -lFFTLIB_C7524.lib
                -lFFTLIB_common_C7524.lib
                -lAUDIOLIB_C7524.lib
                -lAUDIOLIB_common_C7524.lib
                -ludma.am275x.c75x.ti-c7000.release.lib
                -ldmautils.am275x.c75x.ti-c7000.release.lib
                -llibc.a
            "
        ></configuration>
        <pathVariable name="MCU_PLUS_SDK_PATH" path="${COM_TI_MCU_PLUS_SDK_AMXXX_INSTALL_DIR}" scope="project" />
        <file path="../main.c" openOnCreation="false" excludeFromBuild="false" action="copy">
        </file>
        <file path="../../../../common/sigchain_dsp_main.c" openOnCreation="false" excludeFromBuild="false" action="copy">
        </file>
        <file path="../../../../common/sigchain_dsp_ipc.c" openOnCreation="false" excludeFromBuild="false" action="copy">
        </file>
        <file path="../../../../common/sigchain_dsp_mcasp.c" openOnCreation="false" excludeFromBuild="false" action="copy">
        </file>
        <file path="../../../../common/sigchain_dsp_cmdproc.c" openOnCreation="false" excludeFromBuild="false" action="copy">
        </file>
        <file path="../../../TISP_eq_gain_mute.cpp" openOnCreation="false" excludeFromBuild="false" action="copy">
        </file>
        <file path="../../../../common/TISP_app_arena_default_config.cpp" openOnCreation="false" excludeFromBuild="false" action="copy">
        </file>
        <file path="linker.cmd" openOnCreation="false" excludeFromBuild="false" action="copy">
        </file>
        <file path="../example.syscfg" openOnCreation="false" excludeFromBuild="false" action="copy">
        </file>
        <file path="${MCU_PLUS_SDK_PATH}/docs/api_guide_am275x/EXAMPLES_TISP_SIGCHAIN_EQ_GAIN_MUTE.html"
                openOnCreation="false" excludeFromBuild="false" targetName="README.html" action="link">
        </file>
        <file path="syscfg_c.rov.xs" openOnCreation="false" excludeFromBuild="false" action="copy">
        </file>
        <file path="makefile_ccs_bootimage_gen" openOnCreation="false" excludeFromBuild="false" action="copy">
        </file>
    </project>
</projectSpec>
