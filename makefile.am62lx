# Various Component Targets
BUILD_COMBO_board = board_a53.gcc-aarch64
BUILD_COMBO_dhrystone_benchmark = dhrystone_benchmark_a53.gcc-aarch64
BUILD_COMBO_drivers = drivers_a53.gcc-aarch64
BUILD_COMBO_freertos_fat = freertos_fat_a53.gcc-aarch64
BUILD_COMBO_freertos = freertos_a53.gcc-aarch64
BUILD_COMBO_nortos = nortos_a53.gcc-aarch64
BUILD_COMBO_atf = atf_a53.gcc-aarch64

# Combine all Components
BUILD_COMBO_ALL = $(BUILD_COMBO_board) $(BUILD_COMBO_dhrystone_benchmark) $(BUILD_COMBO_drivers) $(BUILD_COMBO_freertos_fat) $(BUILD_COMBO_freertos) $(BUILD_COMBO_nortos)

# Combine all External Components
BUILD_COMBO_EXTERNAL_ALL = $(BUILD_COMBO_atf)

# Combine all Pre-built Components
BUILD_COMBO_PREBUILT_ALL =

# Combine all Private Components
BUILD_COMBO_PRIVATE_ALL =

libs: $(BUILD_COMBO_ALL)

libs-external: $(BUILD_COMBO_EXTERNAL_ALL)

libs-prebuilt: $(BUILD_COMBO_PREBUILT_ALL)

libs-private: $(BUILD_COMBO_PRIVATE_ALL)

$(BUILD_COMBO_board):
	$(MAKE) -C source/board -f makefile.am62lx.$(subst board_,,$@) all

$(BUILD_COMBO_dhrystone_benchmark):
	$(MAKE) -C source/dhrystone_benchmark -f makefile.am62lx.$(subst dhrystone_benchmark_,,$@) all

$(BUILD_COMBO_drivers):
	$(MAKE) -C source/drivers -f makefile.am62lx.$(subst drivers_,,$@) all

$(BUILD_COMBO_freertos_fat):
	$(MAKE) -C source/fs/freertos_fat -f makefile.am62lx.$(subst freertos_fat_,,$@) all

$(BUILD_COMBO_freertos):
	$(MAKE) -C source/kernel/freertos -f makefile.am62lx.$(subst freertos_,,$@) all

$(BUILD_COMBO_nortos):
	$(MAKE) -C source/kernel/nortos -f makefile.am62lx.$(subst nortos_,,$@) all

$(BUILD_COMBO_atf):
	$(MAKE) -C source/atf -f makefile.am62lx.$(subst atf_,,$@) all


# Various Component Clean Targets
BUILD_COMBO_CLEAN_board = board_a53.gcc-aarch64_clean
BUILD_COMBO_CLEAN_dhrystone_benchmark = dhrystone_benchmark_a53.gcc-aarch64_clean
BUILD_COMBO_CLEAN_drivers = drivers_a53.gcc-aarch64_clean
BUILD_COMBO_CLEAN_freertos_fat = freertos_fat_a53.gcc-aarch64_clean
BUILD_COMBO_CLEAN_freertos = freertos_a53.gcc-aarch64_clean
BUILD_COMBO_CLEAN_nortos = nortos_a53.gcc-aarch64_clean
BUILD_COMBO_CLEAN_atf = atf_a53.gcc-aarch64_clean

# Combine all Components Clean
BUILD_COMBO_CLEAN_ALL = $(BUILD_COMBO_CLEAN_board) $(BUILD_COMBO_CLEAN_dhrystone_benchmark) $(BUILD_COMBO_CLEAN_drivers) $(BUILD_COMBO_CLEAN_freertos_fat) $(BUILD_COMBO_CLEAN_freertos) $(BUILD_COMBO_CLEAN_nortos)

# Combine all External Components Clean
BUILD_COMBO_EXTERNAL_CLEAN_ALL = $(BUILD_COMBO_CLEAN_atf)

# Combine all Pre-built Components Clean
BUILD_COMBO_PREBUILT_CLEAN_ALL =

libs-clean: $(BUILD_COMBO_CLEAN_ALL)

libs-external-clean: $(BUILD_COMBO_EXTERNAL_CLEAN_ALL)

libs-prebuilt-clean: $(BUILD_COMBO_PREBUILT_CLEAN_ALL)

$(BUILD_COMBO_CLEAN_board):
	$(MAKE) -C source/board -f makefile.am62lx.$(subst board_,,$(subst _clean,,$@)) clean

$(BUILD_COMBO_CLEAN_dhrystone_benchmark):
	$(MAKE) -C source/dhrystone_benchmark -f makefile.am62lx.$(subst dhrystone_benchmark_,,$(subst _clean,,$@)) clean

$(BUILD_COMBO_CLEAN_drivers):
	$(MAKE) -C source/drivers -f makefile.am62lx.$(subst drivers_,,$(subst _clean,,$@)) clean

$(BUILD_COMBO_CLEAN_freertos_fat):
	$(MAKE) -C source/fs/freertos_fat -f makefile.am62lx.$(subst freertos_fat_,,$(subst _clean,,$@)) clean

$(BUILD_COMBO_CLEAN_freertos):
	$(MAKE) -C source/kernel/freertos -f makefile.am62lx.$(subst freertos_,,$(subst _clean,,$@)) clean

$(BUILD_COMBO_CLEAN_nortos):
	$(MAKE) -C source/kernel/nortos -f makefile.am62lx.$(subst nortos_,,$(subst _clean,,$@)) clean

$(BUILD_COMBO_CLEAN_atf):
	$(MAKE) -C source/atf -f makefile.am62lx.$(subst atf_,,$(subst _clean,,$@)) clean


# Various Component Scrub Targets
BUILD_COMBO_SCRUB_board = board_a53.gcc-aarch64_scrub_scrub
BUILD_COMBO_SCRUB_dhrystone_benchmark = dhrystone_benchmark_a53.gcc-aarch64_scrub_scrub
