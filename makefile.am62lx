BUILD_COMBO_SCRUB_atf = atf_a53.gcc-aarch64_scrub_scrub

# Combine all Components Scrub Targets
BUILD_COMBO_SCRUB_ALL = $(BUILD_COMBO_SCRUB_board) $(BUILD_COMBO_SCRUB_dhrystone_benchmark) $(BUILD_COMBO_SCRUB_drivers) $(BUILD_COMBO_SCRUB_freertos_fat) $(BUILD_COMBO_SCRUB_freertos) $(BUILD_COMBO_SCRUB_nortos)

# Combine all External Components Scrub Targets
BUILD_COMBO_EXTERNAL_SCRUB_ALL = $(BUILD_COMBO_SCRUB_atf)

# Combine all Pre-built Components Scrub Targets
BUILD_COMBO_PREBUILT_SCRUB_ALL =

libs-scrub: $(BUILD_COMBO_SCRUB_ALL)

libs-external-scrub: $(BUILD_COMBO_EXTERNAL_SCRUB_ALL)

libs-prebuilt-scrub: $(BUILD_COMBO_PREBUILT_SCRUB_ALL)

$(BUILD_COMBO_SCRUB_board):
	$(MAKE) -C source/board -f makefile.am62lx.$(subst board_,,$(subst _scrub,,$@)) scrub

$(BUILD_COMBO_SCRUB_dhrystone_benchmark):
	$(MAKE) -C source/dhrystone_benchmark -f makefile.am62lx.$(subst dhrystone_benchmark_,,$(subst _scrub,,$@)) scrub

$(BUILD_COMBO_SCRUB_drivers):
	$(MAKE) -C source/drivers -f makefile.am62lx.$(subst drivers_,,$(subst _scrub,,$@)) scrub

$(BUILD_COMBO_SCRUB_freertos_fat):
	$(MAKE) -C source/fs/freertos_fat -f makefile.am62lx.$(subst freertos_fat_,,$(subst _scrub,,$@)) scrub

$(BUILD_COMBO_SCRUB_freertos):
	$(MAKE) -C source/kernel/freertos -f makefile.am62lx.$(subst freertos_,,$(subst _scrub,,$@)) scrub

$(BUILD_COMBO_SCRUB_nortos):
	$(MAKE) -C source/kernel/nortos -f makefile.am62lx.$(subst nortos_,,$(subst _scrub,,$@)) scrub

$(BUILD_COMBO_SCRUB_atf):
	$(MAKE) -C source/atf -f makefile.am62lx.$(subst atf_,,$(subst _scrub,,$@)) scrub


