help:
	@echo  Notes,
	@echo  - Use -j to invoke parallel builds
	@echo  - Use PROFILE=Debug or PROFILE=Release [default] to build in Debug or Release profile
	@echo  .
	@echo  Overall build targets,
	@echo  ======================
	@echo  $(MAKE) -s -f makefile_projectspec.am62lx help
	@echo  .
	@echo  $(MAKE) -s -f makefile_projectspec.am62lx [export all clean]
	@echo  .
	@echo  export = export projectspec to CCS project in the folder ./ccs_projects/,
	@echo           export MUST be called once before 'all' or 'clean'
	@echo  all    = build the previously exported projectspecs
	@echo  clean  = clean the previously exported projectspecs
	@echo  .
	@echo  Example ProjectSpec build targets,
	@echo  ==================================
	@echo  $(MAKE) -s -C examples/benchmarks/coremark_pro_benchmark/cjpeg-rose7-preset/am62lx-evm/a53ss0-0_freertos/gcc-aarch64 -f makefile_projectspec [export all clean]
	@echo  $(MAKE) -s -C examples/benchmarks/coremark_pro_benchmark/core/am62lx-evm/a53ss0-0_freertos/gcc-aarch64 -f makefile_projectspec [export all clean]
	@echo  $(MAKE) -s -C examples/benchmarks/coremark_pro_benchmark/linear_alg-mid-100x100-sp/am62lx-evm/a53ss0-0_freertos/gcc-aarch64 -f makefile_projectspec [export all clean]
	@echo  $(MAKE) -s -C examples/benchmarks/coremark_pro_benchmark/loops-all-mid-10k-sp/am62lx-evm/a53ss0-0_freertos/gcc-aarch64 -f makefile_projectspec [export all clean]
	@echo  $(MAKE) -s -C examples/benchmarks/coremark_pro_benchmark/nnet_test/am62lx-evm/a53ss0-0_freertos/gcc-aarch64 -f makefile_projectspec [export all clean]
