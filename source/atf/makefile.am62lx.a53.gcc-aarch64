export MCU_PLUS_SDK_PATH?=$(abspath ../..)
include $(MCU_PLUS_SDK_PATH)/imports.mak

DEVICE:=am62lx
PROFILE?=release
ATF_LIB_DIR:=lib/soc/$(DEVICE)

all: $(ATF_LIB_DIR)
ifneq ($(OS),Windows_NT)
	$(MAKE) -f makefile.am62lx.a53_atf.gcc-aarch64 ATF_JUMP_ADDR=0x82000000 ATF_CORE=a53ss0-0
endif
clean:
ifneq ($(OS),Windows_NT)
	$(MAKE) -f makefile.am62lx.a53_atf.gcc-aarch64 ATF_CORE=a53ss0-0 clean
endif
scrub:
ifneq ($(OS),Windows_NT)
	$(MAKE) -f makefile.am62lx.a53_atf.gcc-aarch64 scrub
	$(RMDIR)  $(ATF_LIB_DIR)
endif

$(ATF_LIB_DIR) :
	$(MKDIR) $@
