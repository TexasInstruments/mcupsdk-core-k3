%%{
    let common = system.getScript("/common");
%%}
/*
 * HYPERRAM
 */
#include <board/hyperRam.h>

/* HYPERRAM Driver handles */
extern HYPERRAM_Handle gHyperRamHandle[CONFIG_HYPERRAM_NUM_INSTANCES];

% if(common.getSocName() == "am275x") {
/*
 * HyperRam Driver Advance Parameters - to be used only when Board_driversOpen() and
 * Board_driversClose() is not used by the application
 */

extern HyperRam_Config gHyperRamConfig[CONFIG_HYPERRAM_NUM_INSTANCES];
%}

/* HyperRam Driver open/close - can be used by application when Board_driversOpen() and
 * Board_driversClose() is not used directly and app wants to control the various driver
 * open/close sequences */
int32_t Board_hyperRamOpen(void);
void Board_hyperRamClose(void);
