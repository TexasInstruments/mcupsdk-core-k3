%%{
    let module = system.modules['/drivers/adc/adc'];
    let common   = system.getScript("/common");
    let soc = system.getScript(`/drivers/soc/drivers_${common.getSocName()}`);
%%}


    {
        /* ADC */
    %for(let i = 0; i < module.$instances.length; i++) {
        % let instance = module.$instances[i];
        % let config = module.getInstanceConfig(instance);
        % if (["am62lx"].includes(common.getSocName())) {
        /* Set ADC clock source */
        SCMI_Handle handle = SCMI_getHandle(SCMI_getInitDriverIndex());
        int32_t status = SCMI_clockParentSet(handle,`config.clockIds[0]`,`config.clkSelParentValue`);
        DebugP_assertNoLog(status == SystemP_SUCCESS);
        % }
    % }
    }
