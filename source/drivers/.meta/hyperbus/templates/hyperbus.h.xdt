%%{
    let module = system.modules['/drivers/hyperbus/hyperbus'];
%%}
/*
 * HYPERBUS
 */
#include <drivers/hyperbus.h>

/* HYPERBUS Instance Macros */
% for(let i = 0; i < module.$instances.length; i++) {
    % let instance = module.$instances[i];
#define `instance.$name.toUpperCase()` (`i`U)
% }
#define CONFIG_HYPERBUS_NUM_INSTANCES (`module.$instances.length`U)