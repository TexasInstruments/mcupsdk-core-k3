/*
 * HYPERBUS
 */
#include <drivers/hyperbus.h>

/* HYPERBUS Driver handles */
extern HYPERBUS_Handle gHyperBusHandle[CONFIG_HYPERBUS_NUM_INSTANCES];

/*
 * HYPERBUS Driver Advance Parameters - to be used only when Driver_open() and
 * Driver_close() is not used by the application
 */
/* HYPERBUS Driver open/close - can be used by application when Driver_open() and
 * Driver_close() is not used directly and app wants to control the various driver
 * open/close sequences */
void Drivers_hyperbusOpen(void);
void Drivers_hyperbusClose(void);
