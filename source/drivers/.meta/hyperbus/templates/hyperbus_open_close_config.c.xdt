%%{
    let common = system.getScript("/common");
    let soc = system.getScript(`/drivers/soc/drivers_${common.getSocName()}`);
    let driverVer = soc.getDriverVer("hyperbus");
    let module = system.modules['/drivers/hyperbus/hyperbus'];
%%}
/*
 * HYPERBUS
 */
/* HYPERBUS Driver handles */
HYPERBUS_Handle gHyperBusHandle[CONFIG_HYPERBUS_NUM_INSTANCES];

% if (common.isDMWithBootSupported()) {
static uint32_t gHyperBusAddedByBootloader[CONFIG_HYPERBUS_NUM_INSTANCES] =
{
% for(let i = 0; i < module.$instances.length; i++) {
    % let instance = module.$instances[i];
    % let config = module.getInstanceConfig(instance);
    `config.addedByBootloader.toString(10).toUpperCase()`,
% }
};
% }

void Drivers_hyperbusOpen(void)
{
    uint32_t instCnt;
    int32_t  status = SystemP_SUCCESS;

    for(instCnt = 0U; instCnt < CONFIG_HYPERBUS_NUM_INSTANCES; instCnt++)
    {
        gHyperBusHandle[instCnt] = NULL;   /* Init to NULL so that we can exit gracefully */
    }

    /* Open all instances */
    for(instCnt = 0U; instCnt < CONFIG_HYPERBUS_NUM_INSTANCES; instCnt++)
    {
        % if (common.isDMWithBootSupported()) {
            gHyperBusHandle[instCnt] = HYPERBUS_open(instCnt);
            if(NULL == gHyperBusHandle[instCnt])
            {
                DebugP_logError("HYPERBUS open failed for instance %d !!!\r\n", instCnt);
                status = SystemP_FAILURE;
                break;
            }
        % }
        % else {
        gHyperBusHandle[instCnt] = HYPERBUS_open(instCnt);
        if(NULL == gHyperBusHandle[instCnt])
        {
            DebugP_logError("HYPERBUS open failed for instance %d !!!\r\n", instCnt);
            status = SystemP_FAILURE;
            break;
        }
        % }
    }

    if(SystemP_FAILURE == status)
    {
        Drivers_hyperbusClose();   /* Exit gracefully */
    }

    return;
}

void Drivers_hyperbusClose(void)
{
    uint32_t instCnt;

    /* Close all instances that are open */
    for(instCnt = 0U; instCnt < CONFIG_HYPERBUS_NUM_INSTANCES; instCnt++)
    {
        % if (common.isDMWithBootSupported()) {
        if(!gHyperBusAddedByBootloader[instCnt])
        {
            if(gHyperBusHandle[instCnt] != NULL)
            {
                HYPERBUS_close(gHyperBusHandle[instCnt]);
                gHyperBusHandle[instCnt] = NULL;
            }
        }
        % }
        % else {
            if(gHyperBusHandle[instCnt] != NULL)
            {
                HYPERBUS_close(gHyperBusHandle[instCnt]);
                gHyperBusHandle[instCnt] = NULL;
            }
        % }
    }

    return;
}
