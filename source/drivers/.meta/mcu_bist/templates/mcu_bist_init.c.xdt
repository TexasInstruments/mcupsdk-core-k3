%%{
    let common = system.getScript("/common");
    let soc = system.getScript(`/drivers/mcu_bist/soc/mcu_bist_${common.getSocName()}`);
    let module = system.modules['/drivers/mcu_bist/mcu_bist'];
    let instance = module.$instances[0];
    let config = module.getInstanceConfig(instance);
%%}

% if(instance.bist === "LBIST" || instance.bist === "PBIST"){
    /* BIST */
    {
        int32_t status;
        % if (config.bist === "LBIST"){

        /* Initialize SDL DPL */
        status = SDL_dplInit();
        DebugP_assert(status == SDL_PASS);

        /* Unlock MMRs */
        SOC_controlModuleUnlockMMR(SOC_DOMAIN_ID_MAIN, 4u);
        SOC_controlModuleUnlockMMR(SOC_DOMAIN_ID_MCU, 3u);

        /* Start LBIST */
        status = SDL_LBIST_selfTest(`soc.getSdlLbistInstances()`, SDL_LBIST_TEST);
        DebugP_assert(status == SDL_PASS);
        % }
        % if (config.bist === "PBIST"){

        /* Start Positive PBIST tests of all selected instances*/
        status = SDL_PBIST_startAllTests(true);
        DebugP_assert(status == SDL_PASS);
        % }
    }
%}