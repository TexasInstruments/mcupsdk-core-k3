%%{
    let common = system.getScript("/common");
    let ospiModule = system.modules['/drivers/ospi/ospi']
    let ospiInst = ospiModule.$instances[0];
    let ospiConfig = ospiModule.getInstanceConfig(ospiInst);
%%}
% if (!common.getSocName().match("j722s") || ospiConfig.addedByBootloader == false) {
    OSPI_deinit();
%}
