%%{
    let options = args.options;

    let stackSize = 0x8000;
    let heapSize = 0x2000;
    let irqStackSize = 0x1000;
    let svcStackSize = 0x0100;
    let fiqStackSize = 0x0100;
    let abortStackSize = 0x0100;
    let undefinedStackSize = 0x0100;

    if(options && options.stackSize)
        stackSize = options.stackSize;
    if(options && options.heapSize)
        heapSize = options.heapSize;
    if(options && options.irqStackSize)
        irqStackSize = options.irqStackSize;
    if(options && options.fiqStackSize)
        fiqStackSize = options.fiqStackSize;
    if(options && options.svcStackSize)
        svcStackSize = options.svcStackSize;
    if(options && options.abortStackSize)
        abortStackSize = options.abortStackSize;
    if(options && options.undefinedStackSize)
        undefinedStackSize = options.undefinedStackSize;
%%}
--retain="*(.bootCode)";
--retain="*(.startupCode)";
--retain="*(.startupData)";
--retain="*(.irqStack)";
--retain="*(.fiqStack)";
--retain="*(.abortStack)";
--retain="*(.undefinedstack)";
--retain="*(.svcStack)";
--fill_value=0
--stack_size=0x`stackSize.toString(16).toUpperCase()`
--heap_size=0x`heapSize.toString(16).toUpperCase()`
-e_vectors /* for SBL make sure to set entry point to _vectors_sbl */

__IRQ_STACK_SIZE = 0x`irqStackSize.toString(16).toUpperCase()`;
__FIQ_STACK_SIZE = 0x0`fiqStackSize.toString(16).toUpperCase()`;
__SVC_STACK_SIZE = 0x0`svcStackSize.toString(16).toUpperCase()`;
__ABORT_STACK_SIZE = 0x0`abortStackSize.toString(16).toUpperCase()`;
__UNDEFINED_STACK_SIZE = 0x0`undefinedStackSize.toString(16).toUpperCase()`;

SECTIONS
{
    .vectors            : {} palign(8) > WKUP_R5_MSRAM_VEC
    .bootCode           : align = 8, load = WKUP_R5_MSRAM, run = WKUP_R5_MSRAM
    .startupCode        : align = 8, load = WKUP_R5_MSRAM, run = WKUP_R5_MSRAM
    .startupData        : align = 8, load = WKUP_R5_MSRAM, run = WKUP_R5_MSRAM, type = NOINIT

    GROUP {
        .text.hwi: palign(8)
        .text.cache: palign(8)
        .text.mpu: palign(8)
        .text.boot: palign(8)
        .text:abort: palign(8)
    } > WKUP_R5_MSRAM

    .text            : {} palign(8)      > WKUP_R5_MSRAM
    .const           : {} palign(8)      > WKUP_R5_MSRAM
    .rodata          : {} palign(8)      > WKUP_R5_MSRAM
    .cinit           : {} palign(8)      > WKUP_R5_MSRAM
    .far             : {} align(8)       > WKUP_R5_MSRAM
    .data            : {} palign(128)    > WKUP_R5_MSRAM
    .sysmem          : {} palign(8)      > WKUP_R5_MSRAM
    .data_buffer     : {} palign(128)    > WKUP_R5_MSRAM
    .boardcfg_data   : {} align(8)       > WKUP_R5_MSRAM

    GROUP {
        .bss:    {} palign(8)
        RUN_START(__BSS_START)
        RUN_END(__BSS_END)
    } > WKUP_R5_MSRAM

    .dm_rmpm_trace_buf : (NOLOAD) {} > WKUP_DM_RMPM_TRACE

    .benchmark_buffer (NOLOAD) {} ALIGN (8) > WKUP_R5_MSRAM

    .stack      : {} align(8) > WKUP_R5_MSRAM

    GROUP {
        .irqstack: {. = . + __IRQ_STACK_SIZE;} align(8)
        RUN_START(__IRQ_STACK_START)
        RUN_END(__IRQ_STACK_END)
        .fiqstack: {. = . + __FIQ_STACK_SIZE;} align(8)
        RUN_START(__FIQ_STACK_START)
        RUN_END(__FIQ_STACK_END)
        .svcstack: {. = . + __SVC_STACK_SIZE;} align(8)
        RUN_START(__SVC_STACK_START)
        RUN_END(__SVC_STACK_END)
        .abortstack: {. = . + __ABORT_STACK_SIZE;} align(8)
        RUN_START(__ABORT_STACK_START)
        RUN_END(__ABORT_STACK_END)
        .undefinedstack: {. = . + __UNDEFINED_STACK_SIZE;} align(8)
        RUN_START(__UNDEFINED_STACK_START)
        RUN_END(__UNDEFINED_STACK_END)
    } > WKUP_R5_MSRAM

    GROUP {
        .ARM.exidx:  {} palign(8)
        .init_array: {} palign(8)
        .fini_array: {} palign(8)
    } > WKUP_R5_MSRAM
}

MEMORY
{
    R5F_TCMA_VEC   (RWIX)      : ORIGIN = 0x00000000 LENGTH = 0x00000040
    R5F_TCMA       (RWIX)      : ORIGIN = 0x00000040 LENGTH = 0x00007FC0
    R5F_TCMB_VEC   (RWIX)      : ORIGIN = 0x41010000 LENGTH = 0x00000040
    R5F_TCMB       (RWIX)      : ORIGIN = 0x41010040 LENGTH = 0x00007FC0

    WKUP_R5_MSRAM_VEC (RWIX)     : ORIGIN = 0x72000000 LENGTH = 0x40
    WKUP_R5_MSRAM (RWIX)         : ORIGIN = 0x72000040 LENGTH = 0x0007AFC0
    WKUP_DM_RMPM_TRACE (RWIX)    : ORIGIN = 0x7207B000 LENGTH = 0x00005000

    R50_0_OCRAM   (RWIX)       : ORIGIN = 0x72080000 LENGTH = 0x00100000
    R50_1_OCRAM   (RWIX)       : ORIGIN = 0x72180000 LENGTH = 0x00080000
    R51_0_OCRAM   (RWIX)       : ORIGIN = 0x72280000 LENGTH = 0x00080000
    R51_1_OCRAM   (RWIX)       : ORIGIN = 0x72300000 LENGTH = 0x00080000

    C75_0_OCRAM   (RWIX)       : ORIGIN = 0x72200000 LENGTH = 0x00080000
    C75_1_OCRAM   (RWIX)       : ORIGIN = 0x72400000 LENGTH = 0x00080000
}
