mmu_armv85.$name = "DRU";
mmu_armv85.vAddr = 0x7D400000;
mmu_armv85.pAddr = 0x7D400000;
mmu_armv85.size  = 0x300000;

mmu_armv86.$name     = "L2SRAM";
mmu_armv86.vAddr     = 0x7F000000;
