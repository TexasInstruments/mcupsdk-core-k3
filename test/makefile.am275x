# Various Component Targets
BUILD_COMBO_unity = unity_r5f.ti-arm-clang unity_c75x.ti-c7000
BUILD_COMBO_drivers-i2c-inject-fault = drivers-i2c-inject-fault_r5f.ti-arm-clang drivers-i2c-inject-fault_wkup-r5f.ti-arm-clang
BUILD_COMBO_drivers-mmcsd-inject-fault = drivers-mmcsd-inject-fault_r5f.ti-arm-clang drivers-mmcsd-inject-fault_wkup-r5f.ti-arm-clang
BUILD_COMBO_doxy_samples = doxy_samples_r5f.ti-arm-clang

# Combine all Components
BUILD_COMBO_ALL = $(BUILD_COMBO_unity) $(BUILD_COMBO_drivers-i2c-inject-fault) $(BUILD_COMBO_drivers-mmcsd-inject-fault) $(BUILD_COMBO_doxy_samples)

# Combine all External Components
BUILD_COMBO_EXTERNAL_ALL =

# Combine all Pre-built Components
BUILD_COMBO_PREBUILT_ALL =

# Combine all Private Components
BUILD_COMBO_PRIVATE_ALL =

# Linux-only Components (not built on Windows)
ifneq ($(OS),Windows_NT)
BUILD_COMBO_LINUX_ONLY_ALL =
BUILD_COMBO_LINUX_ONLY_CLEAN_ALL =
BUILD_COMBO_LINUX_ONLY_SCRUB_ALL =
else
BUILD_COMBO_LINUX_ONLY_ALL =
BUILD_COMBO_LINUX_ONLY_CLEAN_ALL =
BUILD_COMBO_LINUX_ONLY_SCRUB_ALL =
endif

libs: $(BUILD_COMBO_ALL) $(BUILD_COMBO_LINUX_ONLY_ALL)

libs-external: $(BUILD_COMBO_EXTERNAL_ALL)

libs-prebuilt: $(BUILD_COMBO_PREBUILT_ALL)

libs-private: $(BUILD_COMBO_PRIVATE_ALL)

$(BUILD_COMBO_unity):
	$(MAKE) -C unity -f makefile.am275x.$(subst unity_,,$@) all

$(BUILD_COMBO_drivers-i2c-inject-fault):
	$(MAKE) -C drivers/i2c/test_i2c_fault_inject/configs -f makefile.am275x.$(subst drivers-i2c-inject-fault_,,$@) all

$(BUILD_COMBO_drivers-mmcsd-inject-fault):
	$(MAKE) -C drivers/mmcsd/test_mmcsd_fault_inject/configs -f makefile.am275x.$(subst drivers-mmcsd-inject-fault_,,$@) all

$(BUILD_COMBO_doxy_samples):
	$(MAKE) -C ../docs_src/docs/api_guide/doxy_samples -f makefile.am275x.$(subst doxy_samples_,,$@) all


# Various Component Clean Targets
BUILD_COMBO_CLEAN_unity = unity_r5f.ti-arm-clang_clean unity_c75x.ti-c7000_clean
BUILD_COMBO_CLEAN_drivers-i2c-inject-fault = drivers-i2c-inject-fault_r5f.ti-arm-clang_clean drivers-i2c-inject-fault_wkup-r5f.ti-arm-clang_clean
BUILD_COMBO_CLEAN_drivers-mmcsd-inject-fault = drivers-mmcsd-inject-fault_r5f.ti-arm-clang_clean drivers-mmcsd-inject-fault_wkup-r5f.ti-arm-clang_clean
BUILD_COMBO_CLEAN_doxy_samples = doxy_samples_r5f.ti-arm-clang_clean

# Combine all Components Clean
BUILD_COMBO_CLEAN_ALL = $(BUILD_COMBO_CLEAN_unity) $(BUILD_COMBO_CLEAN_drivers-i2c-inject-fault) $(BUILD_COMBO_CLEAN_drivers-mmcsd-inject-fault) $(BUILD_COMBO_CLEAN_doxy_samples)

# Combine all External Components Clean
BUILD_COMBO_EXTERNAL_CLEAN_ALL =

# Combine all Pre-built Components Clean
BUILD_COMBO_PREBUILT_CLEAN_ALL =

libs-clean: $(BUILD_COMBO_CLEAN_ALL) $(BUILD_COMBO_LINUX_ONLY_CLEAN_ALL)

libs-external-clean: $(BUILD_COMBO_EXTERNAL_CLEAN_ALL)

libs-prebuilt-clean: $(BUILD_COMBO_PREBUILT_CLEAN_ALL)

$(BUILD_COMBO_CLEAN_unity):
	$(MAKE) -C unity -f makefile.am275x.$(subst unity_,,$(subst _clean,,$@)) clean

$(BUILD_COMBO_CLEAN_drivers-i2c-inject-fault):
	$(MAKE) -C drivers/i2c/test_i2c_fault_inject/configs -f makefile.am275x.$(subst drivers-i2c-inject-fault_,,$(subst _clean,,$@)) clean

$(BUILD_COMBO_CLEAN_drivers-mmcsd-inject-fault):
	$(MAKE) -C drivers/mmcsd/test_mmcsd_fault_inject/configs -f makefile.am275x.$(subst drivers-mmcsd-inject-fault_,,$(subst _clean,,$@)) clean

$(BUILD_COMBO_CLEAN_doxy_samples):
	$(MAKE) -C ../docs_src/docs/api_guide/doxy_samples -f makefile.am275x.$(subst doxy_samples_,,$(subst _clean,,$@)) clean


# Various Component Scrub Targets
BUILD_COMBO_SCRUB_unity = unity_r5f.ti-arm-clang_scrub unity_c75x.ti-c7000_scrub
BUILD_COMBO_SCRUB_drivers-i2c-inject-fault = drivers-i2c-inject-fault_r5f.ti-arm-clang_scrub drivers-i2c-inject-fault_wkup-r5f.ti-arm-clang_scrub
