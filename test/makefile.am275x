# Combine all External Components Scrub Targets
BUILD_COMBO_EXTERNAL_SCRUB_ALL =

# Combine all Pre-built Components Scrub Targets
BUILD_COMBO_PREBUILT_SCRUB_ALL =

libs-scrub: $(BUILD_COMBO_SCRUB_ALL) $(BUILD_COMBO_LINUX_ONLY_SCRUB_ALL)

libs-external-scrub: $(BUILD_COMBO_EXTERNAL_SCRUB_ALL)

libs-prebuilt-scrub: $(BUILD_COMBO_PREBUILT_SCRUB_ALL)

$(BUILD_COMBO_SCRUB_unity):
	$(MAKE) -C unity -f makefile.am275x.$(subst unity_,,$(subst _scrub,,$@)) scrub

$(BUILD_COMBO_SCRUB_drivers-i2c-inject-fault):
	$(MAKE) -C drivers/i2c/test_i2c_fault_inject/configs -f makefile.am275x.$(subst drivers-i2c-inject-fault_,,$(subst _scrub,,$@)) scrub

$(BUILD_COMBO_SCRUB_drivers-mmcsd-inject-fault):
