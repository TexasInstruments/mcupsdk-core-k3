#
# Auto generated makefile
#

all:
	$(MAKE) -f makefile.am62lx libs
	$(MAKE) -f makefile.am62lx libs-external
	$(MAKE) -f makefile.am62lx sbl
	$(MAKE) -f makefile.am62lx examples

clean: libs-clean libs-external-clean sbl-clean examples-clean
scrub: libs-scrub libs-external-scrub sbl-scrub examples-scrub

help:
	@echo  Notes,
	@echo  - Use -j to invoke parallel builds
	@echo  - Use PROFILE=debug or PROFILE=release [default] to build in debug or release profile
	@echo  .
	@echo  Overall build targets,
	@echo  ======================
	@echo  $(MAKE) -s -f makefile.am62lx help
	@echo  .
	@echo  $(MAKE) -s -f makefile.am62lx all
	@echo  $(MAKE) -s -f makefile.am62lx clean  # delete's tmp files for current profile
	@echo  $(MAKE) -s -f makefile.am62lx scrub  # delete's all tmp files and folders for all profiles
	@echo  .
	@echo  $(MAKE) -s -f makefile.am62lx libs
	@echo  $(MAKE) -s -f makefile.am62lx libs-clean # delete's tmp files for current profile
	@echo  $(MAKE) -s -f makefile.am62lx libs-scrub # delete's all tmp files and folders for all profiles
	@echo  .
	@echo  $(MAKE) -s -f makefile.am62lx examples
	@echo  $(MAKE) -s -f makefile.am62lx examples-clean # delete's tmp files for current profile
	@echo  $(MAKE) -s -f makefile.am62lx examples-scrub # delete's all tmp files and folders for all profiles
	@echo  .
	@echo  Library build targets,
	@echo  ======================
	@echo  $(MAKE) -s -f makefile.am62lx unity_a53.gcc-aarch64
	@echo  .
	@echo  Library clean targets,
	@echo  ======================
	@echo  $(MAKE) -s -f makefile.am62lx unity_a53.gcc-aarch64_clean
	@echo  .
	@echo  Example build targets,
	@echo  ======================
	@echo  $(MAKE) -s -C drivers/epwm/am62lx-sk/a53ss0-0_nortos/gcc-aarch64 [all clean syscfg-gui syscfg]
	@echo  $(MAKE) -s -C drivers/epwm/am62lx-sk/a53ss0-0_freertos/gcc-aarch64 [all clean syscfg-gui syscfg]
	@echo  $(MAKE) -s -C drivers/gpio/am62lx-sk/a53ss0-0_nortos/gcc-aarch64 [all clean syscfg-gui syscfg]
	@echo  $(MAKE) -s -C drivers/gpio/am62lx-sk/a53ss0-0_freertos/gcc-aarch64 [all clean syscfg-gui syscfg]
	@echo  $(MAKE) -s -C drivers/i2c/am62lx-sk/a53ss0-0_nortos/gcc-aarch64 [all clean syscfg-gui syscfg]
	@echo  $(MAKE) -s -C drivers/i2c/am62lx-sk/a53ss0-0_freertos/gcc-aarch64 [all clean syscfg-gui syscfg]
	@echo  $(MAKE) -s -C drivers/uart/am62lx-sk/a53ss0-0_nortos/gcc-aarch64 [all clean syscfg-gui syscfg]
	@echo  $(MAKE) -s -C drivers/uart/am62lx-sk/a53ss0-0_freertos/gcc-aarch64 [all clean syscfg-gui syscfg]
	@echo  $(MAKE) -s -C kernel/dpl/am62lx-sk/a53ss0-0_nortos/gcc-aarch64 [all clean syscfg-gui syscfg]
	@echo  $(MAKE) -s -C kernel/dpl/am62lx-sk/a53ss0-0_freertos/gcc-aarch64 [all clean syscfg-gui syscfg]
	@echo  $(MAKE) -s -C kernel/freertos/am62lx-sk/a53ss0-0_freertos/gcc-aarch64 [all clean syscfg-gui syscfg]
	@echo  .
	@echo  System Example build targets,
	@echo  =============================
