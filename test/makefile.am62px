# Combine all Components
BUILD_COMBO_ALL = $(BUILD_COMBO_unity) $(BUILD_COMBO_drivers-mmcsd-inject-fault) $(BUILD_COMBO_drivers-i2c-inject-fault) $(BUILD_COMBO_drivers-mcasp-inject-fault) $(BUILD_COMBO_drivers-udma-inject-fault) $(BUILD_COMBO_drivers-mcspi-inject-fault) $(BUILD_COMBO_doxy_samples)

