BUILD_COMBO_EXTERNAL_ALL =

# Combine all Pre-built Components
BUILD_COMBO_PREBUILT_ALL =

# Combine all Private Components
BUILD_COMBO_PRIVATE_ALL =


libs: $(BUILD_COMBO_ALL)

libs-external: $(BUILD_COMBO_EXTERNAL_ALL)

libs-prebuilt: $(BUILD_COMBO_PREBUILT_ALL)

libs-private: $(BUILD_COMBO_PRIVATE_ALL)

$(BUILD_COMBO_unity):
	$(MAKE) -C unity -f makefile.am62px.$(subst unity_,,$@) all

$(BUILD_COMBO_drivers-mmcsd-inject-fault):
	$(MAKE) -C drivers/mmcsd/test_mmcsd_fault_inject/configs -f makefile.am62px.$(subst drivers-mmcsd-inject-fault_,,$@) all

$(BUILD_COMBO_drivers-i2c-inject-fault):
	$(MAKE) -C drivers/i2c/test_i2c_fault_inject/configs -f makefile.am62px.$(subst drivers-i2c-inject-fault_,,$@) all

$(BUILD_COMBO_drivers-mcasp-inject-fault):
