# Various Component Targets
BUILD_COMBO_unity = unity_r5f.ti-arm-clang
BUILD_COMBO_drivers-mmcsd-inject-fault = drivers-mmcsd-inject-fault_wkup-r5f.ti-arm-clang drivers-mmcsd-inject-fault_mcu-r5f.ti-arm-clang
