$(BUILD_COMBO_drivers-udma-inject-fault):
	$(MAKE) -C drivers/udma/test_udma_fault_inject/configs -f makefile.am62px.$(subst drivers-udma-inject-fault_,,$@) all

$(BUILD_COMBO_drivers-mcspi-inject-fault):
	$(MAKE) -C drivers/mcspi/test_mcspi_fault_inject/configs -f makefile.am62px.$(subst drivers-mcspi-inject-fault_,,$@) all

$(BUILD_COMBO_doxy_samples):
	$(MAKE) -C ../docs_src/docs/api_guide/doxy_samples -f makefile.am62px.$(subst doxy_samples_,,$@) all


